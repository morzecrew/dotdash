# dotdash-client: the ways traffic reaches Xray, and where it goes from there.
# Rendered by render.sh.
direction: down

apps: "Apps set to use\na SOCKS5 or HTTP proxy"
gw: "LAN devices whose\ngateway is this machine\n(tun, gateway=true)"

machine: Client machine {
  own: "Its own connections\n(the tun profile)"
  xray: Xray {
    label: "Xray\nblock_rules, direct_rules,\nthe subscription's fastest link"
  }
  own -> xray: TUN
}

apps -> machine.xray: port 7890
gw -> machine.xray: TUN

dotdash: dotdash server\nor a relay
direct: Direct {shape: cloud}

machine.xray -> dotdash: everything else
machine.xray -> direct: direct_rules {style.stroke-dash: 4}
