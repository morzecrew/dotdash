# A relay inside the restricted network, carrying devices on to the dotdash servers.
# Rendered by render.sh.
direction: down

inside: Inside the restricted network {
  style.stroke-dash: 4

  phone: Phone\nwith a relay link
  probe: A probe
  relay: dotdash-relay {
    label: "dotdash-relay\nan address that gets through,\nits own keys"
  }
  site: "A site next to the relay\n(the site parameter)"

  phone -> relay: "443, under\nthe site's name"
  probe -> relay {style.stroke-dash: 4}
  relay -> site: "a probe gets\nits handshake" {style.stroke-dash: 4}
}

outside: Outside it {
  a: dotdash\na.example.com
  b: dotdash\nb.example.com
}

upstream: "Your upstream proxy,\nthen the internet"

inside.relay -> outside.a: "as one client,\nthe fastest server"
inside.relay -> outside.b {style.stroke-dash: 4}
outside.a -> upstream
outside.b -> upstream
