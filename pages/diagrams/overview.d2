# The four bundles and where each runs. Rendered by render.sh.
direction: down

inside: Inside the censored country {
  style.stroke-dash: 4

  phone: Phone or laptop\nwith a dotdash link

  devices: LAN devices\nwith no app
  client: dotdash-client\na Linux machine
  devices -> client: proxy port\nor gateway

  relay: dotdash-relay\na domestic address
  canary: dotdash-canary\nalerts when blocked
}

abroad: Abroad {
  server: dotdash\nyour server
}

upstream: Your upstream proxy
internet: Internet {shape: cloud}

inside.phone -> abroad.server: REALITY, XHTTP,\nDNS tunnel
inside.phone -> inside.relay: only domestic\naddresses get through {style.stroke-dash: 4}
inside.relay -> abroad.server
inside.client -> abroad.server
inside.canary -> abroad.server: test connections {style.stroke-dash: 4}
abroad.server -> upstream: the only way out
upstream -> internet
