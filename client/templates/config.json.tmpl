{{- /* Published beyond this machine, the proxy asks for a password. */ -}}
{{- $lan := ne (default "127.0.0.1" .Parameters.listen) "127.0.0.1" -}}
{{- $probe := required "set probe_url" .Parameters.probe_url -}}
{
  "mode": "rule",
  "log-level": "warning",
  "ipv6": false,
  "listeners": [
    {"name": "proxy", "type": "mixed", "listen": "0.0.0.0", "port": 7890,
     "users": [{{ if $lan }}{"username": "{{ required "set proxy_user" .Parameters.proxy_user }}", "password": {"$file": "/run/secrets/proxy_password"}}{{ end }}]},
    {"name": "probe", "type": "mixed", "listen": "127.0.0.1", "port": 7891, "users": []}
  ],
  "proxy-providers": {
    "dotdash": {
      "type": "http",
      "url": {"$file": "/run/secrets/subscription_url"},
      "interval": {{ .Parameters.subscription_interval }},
      {{- /* Fetched through the fetch group below, so it refreshes where only
      dotdash gets through. Without a proxy here, mihomo would send the fetch
      through the rules, into the dotdash group, which refuses while empty. */}}
      "proxy": "fetch",
      "path": "./proxies/dotdash.yaml",
      "health-check": {"enable": true, "url": "{{ $probe }}", "interval": 300}
    }
  },
  {{- /* An empty group falls back to COMPATIBLE, mihomo's DIRECT. So the
  group traffic takes refuses while there are no links, as before a first
  fetch, and nothing leaves around dotdash. The fetch group, which no rule
  sends traffic to, keeps COMPATIBLE: the subscription goes through dotdash's
  links when there are any, and directly when there are none. */}}
  "proxy-groups": [
    {"name": "dotdash", "type": "url-test", "use": ["dotdash"], "url": "{{ $probe }}", "interval": 300,
     "empty-fallback": "REJECT"},
    {"name": "fetch", "type": "url-test", "use": ["dotdash"], "url": "{{ $probe }}", "interval": 300}
  ],
  {{- /* The rule parameters, inline: each line a classical rule without its
  target, blank and "#" lines skipped. A rule that matches nothing
  (never.invalid) leads each list, so every kept line can follow a comma.
  Backslashes are doubled before quote, which escapes only quotes. */}}
  "rule-providers": {
    "block": {"type": "inline", "behavior": "classical", "payload": ["DOMAIN,never.invalid"
      {{- range lines .Parameters.block_rules }}{{ $l := trim . }}{{ if and $l (ne (slice $l 0 1) "#") }}, {{ quote (replace $l "\\" "\\\\") }}{{ end }}{{ end }}]},
    "direct": {"type": "inline", "behavior": "classical", "payload": ["DOMAIN,never.invalid"
      {{- range lines .Parameters.direct_rules }}{{ $l := trim . }}{{ if and $l (ne (slice $l 0 1) "#") }}, {{ quote (replace $l "\\" "\\\\") }}{{ end }}{{ end }}]}
  },
  "rules": ["RULE-SET,block,REJECT", "RULE-SET,direct,DIRECT", "MATCH,dotdash"]
}
