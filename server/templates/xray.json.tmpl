{{- /*
Xray config. Morzer renders it to <etc>/application.yaml, Compose mounts it as
/etc/xray/config.json, and ghcr.io/morzecrew/xray replaces each
{"$file": "<path>"} with that file's content, {"$vlessDecryption": "<path>"}
with the server key derived from that seed, and {"$vlessClients": "<path>"}
with the client list in that file, before starting Xray (platform-images#125,
#130). No secret value is ever in this file.

REALITY owns the public TLS port. A client holding the key gets Xray; anything
else (browsers, scanners, ACME, a CDN) is relayed to Caddy, which serves the
cover site with its own certificate and passes the XHTTP path back here.

The xhttp-reality profiles add XHTTP under REALITY instead of TLS, on a port of
its own (8443 here, xhttp_reality_port outside): same keys, same fallback to
Caddy. No flow on it, as on any XHTTP inbound: Vision is for RAW only.

The mkcp profile adds VLESS over mKCP on UDP (8447 here, kcp_port outside):
no TLS underneath, so another protocol family for the network to block. Its
packets are AES-128-GCM under kcp_seed, then dressed in kcp_header; a client
must name both, in that order, as a link's seed and headerType do.

There is no direct (freedom) outbound: if the upstream proxy is down, traffic
stops rather than leaving from this server's own IP. Nor could there be one:
this container sits on internal networks only, and its one way out is the
gate (gate.json.tmpl), which dials the upstream with the credentials this
container never holds. The last routing rule
names the upstream as the default outright, after the blocks, rather than
leaving it to Xray's rule that the first outbound is the default; UDP the
upstream cannot relay is blocked before it.
*/ -}}
{{- $domain := required "install with --domain" .Installation.Domain -}}
{{- /* resolve=gateway: names are resolved here, over DoH that itself goes out
through the upstream, and the upstream is handed addresses only, so it never
learns the hostnames. ForceIP, not UseIP: UseIP falls back to sending the name
when resolution fails. IPOnDemand resolves before the routing rules, so a name
that points at a private address is blocked like the address. resolve=upstream
hands the upstream the names, as before. */ -}}
{{- $gateway := eq .Parameters.resolve "gateway" -}}
{{- /* upstream6_protocol: a second proxy, for IPv6. A destination with an IPv6
address leaves through it: with resolve=gateway, IPOnDemand resolves a name
for the ::/0 rule, so a name with an AAAA record matches it, and the hop
hands that proxy IPv6 addresses only (ForceIPv6) and the first IPv4 only
(ForceIPv4). Neither falls back to the other. With resolve=upstream only IPv6
literals match. IPv6 UDP is blocked: the hop to it carries none. */ -}}
{{- $v6 := ne .Parameters.upstream6_protocol "none" -}}
{{- /* A WireGuard or OpenVPN upstream is a tunnel, which carries UDP as it
carries TCP; a proxy carries UDP only as SOCKS5 with upstream_udp. */ -}}
{{- $tunnel := or (eq .Parameters.upstream_protocol "wireguard") (eq .Parameters.upstream_protocol "openvpn") -}}
{{- $udp := or $tunnel (and (eq (print .Parameters.upstream_udp) "true") (eq .Parameters.upstream_protocol "socks")) -}}
{{- $withXdns := or (has "xdns" .Profiles) (has "xdns-xhttp-reality" .Profiles) -}}
{{- $xhttpReality := or (has "xhttp-reality" .Profiles) (has "xdns-xhttp-reality" .Profiles) -}}
{{- $kcp := has "mkcp" .Profiles -}}
{{- $xdns := .Parameters.xdns_domain -}}
{{- if not (contains $xdns ".") }}{{ $xdns = printf "%s.%s" $xdns $domain }}{{ end -}}
{
  "log": {"loglevel": "{{ .Parameters.log_level }}", "access": "none", "dnsLog": false},
{{- if $gateway }}
  "dns": {"servers": ["{{ .Parameters.dns_resolver }}"], "queryStrategy": "UseIP", "disableFallback": true, "tag": "dns"},
{{- end }}
  "inbounds": [
    {
      "tag": "reality",
      "listen": "0.0.0.0",
      "port": 443,
      "protocol": "vless",
      "settings": {
        "clients": {"$vlessClients": "/run/secrets/vless_clients"},
        "flow": "xtls-rprx-vision",
        "decryption": {"$vlessDecryption": "/run/secrets/vless_seed"}
      },
      "streamSettings": {
        "network": "raw",
        "security": "reality",
        "realitySettings": {
          "target": "caddy:443",
          "serverNames": ["{{ $domain }}"],
          "privateKey": {"$file": "/run/secrets/reality_key"},
          "shortIds": [{"$file": "/run/secrets/reality_short_id"}]
        }
      },
      "sniffing": {"enabled": true, "destOverride": ["http", "tls", "quic"], "routeOnly": true}
    },
    {
      "tag": "xhttp",
      "listen": "0.0.0.0",
      "port": 8080,
      "protocol": "vless",
      "settings": {
        "clients": {"$vlessClients": "/run/secrets/vless_clients"},
        "decryption": {"$vlessDecryption": "/run/secrets/vless_seed"}
      },
      "streamSettings": {
        "network": "xhttp",
        "xhttpSettings": {"path": {"$file": "/run/secrets/xhttp_path"}, "mode": "auto"}
      },
      "sniffing": {"enabled": true, "destOverride": ["http", "tls", "quic"], "routeOnly": true}
    },
{{- if $xhttpReality }}
    {
      "tag": "xhttp-reality",
      "listen": "0.0.0.0",
      "port": 8443,
      "protocol": "vless",
      "settings": {
        "clients": {"$vlessClients": "/run/secrets/vless_clients"},
        "decryption": {"$vlessDecryption": "/run/secrets/vless_seed"}
      },
      "streamSettings": {
        "network": "xhttp",
        "security": "reality",
        "realitySettings": {
          "target": "caddy:443",
          "serverNames": ["{{ $domain }}"],
          "privateKey": {"$file": "/run/secrets/reality_key"},
          "shortIds": [{"$file": "/run/secrets/reality_short_id"}]
        },
        "xhttpSettings": {"path": {"$file": "/run/secrets/xhttp_path"}, "mode": "auto"}
      },
      "sniffing": {"enabled": true, "destOverride": ["http", "tls", "quic"], "routeOnly": true}
    },
{{- end }}
{{- if $kcp }}
    {
      "tag": "kcp",
      "listen": "0.0.0.0",
      "port": 8447,
      "protocol": "vless",
      "settings": {
        "clients": {"$vlessClients": "/run/secrets/vless_clients"},
        "decryption": {"$vlessDecryption": "/run/secrets/vless_seed"}
      },
      "streamSettings": {
        "network": "kcp",
        "finalmask": {"udp": [
          {"type": "mkcp-legacy", "settings": {"value": {"$file": "/run/secrets/kcp_seed"}}}
{{- if ne .Parameters.kcp_header "none" }},
          {"type": "mkcp-legacy", "settings": {"header": "{{ .Parameters.kcp_header }}"}}
{{- end }}
        ]}
      },
      "sniffing": {"enabled": true, "destOverride": ["http", "tls", "quic"], "routeOnly": true}
    },
{{- end }}
{{- if $withXdns }}
    {
      "tag": "xdns",
      "listen": "0.0.0.0",
      "port": 5353,
      "protocol": "vless",
      "settings": {
        "clients": {"$vlessClients": "/run/secrets/vless_clients"},
        "decryption": {"$vlessDecryption": "/run/secrets/vless_seed"}
      },
      "streamSettings": {
        "network": "kcp",
        "kcpSettings": {"mtu": {{ .Parameters.xdns_mtu }}, "tti": 200},
        "finalmask": {"udp": [{"type": "xdns", "settings": {"domains": [{"names": ["{{ $xdns }}"], "edns0": 1232}]}}]}
      },
      "sniffing": {"enabled": true, "destOverride": ["http", "tls", "quic"], "routeOnly": true}
    },
{{- end }}
    {
      "tag": "probe",
      "listen": "127.0.0.1",
      "port": 10809,
      "protocol": "http"
    }
  ],
  "outbounds": [
    {"tag": "upstream", "protocol": "socks", "settings": {"address": "gate", "port": 1080}{{ if $gateway }}, "targetStrategy": "{{ if $v6 }}ForceIPv4{{ else }}ForceIPv4v6{{ end }}"{{ end }}},
    {"tag": "block", "protocol": "blackhole"}
{{- if $v6 }},
    {"tag": "upstream6", "protocol": "socks", "settings": {"address": "gate", "port": 1081}{{ if $gateway }}, "targetStrategy": "ForceIPv6"{{ end }}}
{{- end }}
  ],
  "routing": {
    "domainStrategy": "{{ if $gateway }}IPOnDemand{{ else }}AsIs{{ end }}",
    "rules": [
{{- if $gateway }}
      {"inboundTag": ["dns"], "outboundTag": "upstream"},
{{- end }}
      {"ip": ["geoip:private"], "outboundTag": "block"},
      {"protocol": ["bittorrent"], "outboundTag": "block"}
      {{- if not $udp }},
      {"network": "udp", "outboundTag": "block"}
      {{- end }},
{{- if $v6 }}
      {"network": "udp", "ip": ["::/0"], "outboundTag": "block"},
      {"ip": ["::/0"], "outboundTag": "upstream6"},
{{- end }}
      {"network": "tcp,udp", "outboundTag": "upstream"}
    ]
  }
}
