{{- /*
The gate: the one container with a route out. Xray itself sits on internal
networks only, where a container can neither publish a port nor reach
anything beyond the other containers, so it cannot send traffic anywhere
directly whatever its config says. The gate carries what has to cross:

  - in: the public TLS port, and under their profiles UDP/53 for the DNS
    tunnel, xhttp_reality_port and kcp_port, to Xray, byte for byte
    (dokodemo-door);
  - out: Xray's SOCKS hop to the upstream proxy, which the gate dials with
    the upstream secret's address and credentials, and with
    upstream6_protocol a second hop (1081) to the IPv6 proxy, with its own.
    Xray never holds either. The image splits each secret's
    "user:pass@host:port" into the outbound's settings ({"$proxy": ...}); TLS
    takes the server name from that address.

A tunnel takes the proxy's place. upstream_protocol=wireguard: the outbound
is Xray's own WireGuard, on its built-in TCP/IP stack, so the gate needs no
capability; the image builds its settings from the wg-quick file in the
upstream_wireguard secret ({"$wireguard": ...}). upstream_protocol=openvpn: the outbound
is a SOCKS hop to vpn-socks, which shares the namespace of the OpenVPN client
(vpn, the openvpn profile), whose kill switch leaves it no route but the
tunnel. Either carries UDP, and IPv6 if the exit has it, so neither takes
upstream6; nor resolve=upstream, as a tunnel resolves no names.

upstream_backup_protocol: a second proxy for when the upstream fails, from
the upstream_backup secret. The egress goes to a balancer whose one candidate
is the upstream, and whose fallback is the backup: while the observatory's
probes of healthcheck_url get through the upstream, everything leaves there,
so the exit stays the same; when they stop, the backup, until they get through
again. The balancer matches tags by prefix, so the IPv6 proxy is "ipv6", never
"upstream6".

Nothing else is routed: the freedom outbound carries only the public inbounds,
whose destination is fixed to Xray, and everything else is blocked.
*/ -}}
{{- $withXdns := or (has "xdns" .Profiles) (has "xdns-xhttp-reality" .Profiles) -}}
{{- $xhttpReality := or (has "xhttp-reality" .Profiles) (has "xdns-xhttp-reality" .Profiles) -}}
{{- $kcp := has "mkcp" .Profiles -}}
{{- $v6 := ne .Parameters.upstream6_protocol "none" -}}
{{- $backup := ne .Parameters.upstream_backup_protocol "none" -}}
{{- $proto := .Parameters.upstream_protocol -}}
{{- $tunnel := or (eq $proto "wireguard") (eq $proto "openvpn") -}}
{{- $udp := or $tunnel (and (eq (print .Parameters.upstream_udp) "true") (eq $proto "socks")) -}}
{{- if and $tunnel $v6 }}{{ required (printf "upstream_protocol=%s carries IPv6 itself: unset upstream6_protocol" $proto) "" }}{{ end }}
{{- if and $tunnel (ne .Parameters.resolve "gateway") }}{{ required (printf "upstream_protocol=%s resolves no names: set resolve=gateway" $proto) "" }}{{ end }}
{{- if and (eq $proto "openvpn") (not (has "openvpn" .Profiles)) }}{{ required "upstream_protocol=openvpn needs the openvpn profile, which runs the OpenVPN client: first sudo morzer config set installation.profile=openvpn (with others: xdns,openvpn), then upstream_protocol=openvpn" "" }}{{ end }}
{{- /* Two services cannot publish one host port; refused here, so the apply
stops before anything is replaced. The template language has no fail: required
fails on its empty value with the message. */ -}}
{{- if $xhttpReality }}
{{- if eq .Parameters.xhttp_reality_port .Parameters.https_port }}{{ required "xhttp_reality_port must differ from https_port" "" }}{{ end }}
{{- if eq .Parameters.xhttp_reality_port "80" }}{{ required "xhttp_reality_port must not be 80, which Caddy publishes for ACME" "" }}{{ end }}
{{- end }}
{{- if and $kcp $withXdns (eq .Parameters.kcp_port "53") }}{{ required "kcp_port must not be 53, which the DNS tunnel publishes" "" }}{{ end }}
{
  "log": {"loglevel": "{{ .Parameters.log_level }}", "access": "none", "dnsLog": false},
  "inbounds": [
    {"tag": "public-tls", "listen": "0.0.0.0", "port": 443, "protocol": "dokodemo-door",
     "settings": {"address": "xray", "port": 443, "network": "tcp"}},
{{- if $withXdns }}
    {"tag": "public-dns", "listen": "0.0.0.0", "port": 5353, "protocol": "dokodemo-door",
     "settings": {"address": "xray", "port": 5353, "network": "udp"}},
{{- end }}
{{- if $xhttpReality }}
    {"tag": "public-xhttp-reality", "listen": "0.0.0.0", "port": 8443, "protocol": "dokodemo-door",
     "settings": {"address": "xray", "port": 8443, "network": "tcp"}},
{{- end }}
{{- if $kcp }}
    {"tag": "public-kcp", "listen": "0.0.0.0", "port": 8447, "protocol": "dokodemo-door",
     "settings": {"address": "xray", "port": 8447, "network": "udp"}},
{{- end }}
    {"tag": "egress", "listen": "0.0.0.0", "port": 1080, "protocol": "socks",
     "settings": {"auth": "noauth", "udp": {{ $udp }}}}
{{- if $v6 }},
    {"tag": "egress6", "listen": "0.0.0.0", "port": 1081, "protocol": "socks",
     "settings": {"auth": "noauth", "udp": false}}
{{- end }}
  ],
  "outbounds": [
{{- if eq $proto "wireguard" }}
    {"tag": "upstream", "protocol": "wireguard", "settings": {"$wireguard": "/run/secrets/upstream_wireguard"}},
{{- else if eq $proto "openvpn" }}
    {"tag": "upstream", "protocol": "socks", "settings": {"address": "vpn", "port": 1080}},
{{- else }}
    {
      "tag": "upstream",
      "protocol": "{{ $proto }}",
      "settings": {"$proxy": "/run/secrets/upstream"}
{{- if eq (print .Parameters.upstream_tls) "true" }},
      "streamSettings": {"security": "tls"}
{{- end }}
    },
{{- end }}
    {"tag": "inside", "protocol": "freedom"},
    {"tag": "block", "protocol": "blackhole"}
{{- if $v6 }},
    {
      "tag": "ipv6",
      "protocol": "{{ .Parameters.upstream6_protocol }}",
      "settings": {"$proxy": "/run/secrets/upstream6"}
{{- if eq (print .Parameters.upstream6_tls) "true" }},
      "streamSettings": {"security": "tls"}
{{- end }}
    }
{{- end }}
{{- if $backup }},
    {
      "tag": "backup",
      "protocol": "{{ .Parameters.upstream_backup_protocol }}",
      "settings": {"$proxy": "/run/secrets/upstream_backup"}
{{- if eq (print .Parameters.upstream_backup_tls) "true" }},
      "streamSettings": {"security": "tls"}
{{- end }}
    }
{{- end }}
  ],
{{- if $backup }}
  "observatory": {"subjectSelector": ["upstream", "backup"], "probeUrl": "{{ .Parameters.healthcheck_url }}", "probeInterval": "30s", "enableConcurrency": true},
{{- end }}
  "routing": {
    "domainStrategy": "AsIs",
{{- if $backup }}
    "balancers": [{"tag": "egress", "selector": ["upstream"], "fallbackTag": "backup", "strategy": {"type": "random"}}],
{{- end }}
    "rules": [
      {"inboundTag": ["public-tls"{{ if $withXdns }}, "public-dns"{{ end }}{{ if $xhttpReality }}, "public-xhttp-reality"{{ end }}{{ if $kcp }}, "public-kcp"{{ end }}], "outboundTag": "inside"},
      {"inboundTag": ["egress"], {{ if $backup }}"balancerTag": "egress"{{ else }}"outboundTag": "upstream"{{ end }}},
{{- if $v6 }}
      {"inboundTag": ["egress6"], "outboundTag": "ipv6"},
{{- end }}
      {"network": "tcp,udp", "outboundTag": "block"}
    ]
  }
}
