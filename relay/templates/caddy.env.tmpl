{{- /* The own-site profile's Caddy fetches devices' subscriptions from the
dotdash servers through this relay's tunnel (caddy/Caddyfile): their HTTPS,
named as xray.json.tmpl names them. An env file rather than a mounted one, so a
change re-creates Caddy at the next apply: Compose hashes a service's
environment, never the contents of a file it mounts. */ -}}
{{- $list := .Parameters.dotdash_servers }}{{ if not $list }}{{ $list = .Parameters.dotdash_server }}{{ end -}}
{{- if eq $list "none" }}{{ $list = "" }}{{ end -}}
{{- $servers := split "," (required "set dotdash_servers" $list) -}}
SUBSCRIPTION_UPSTREAMS={{ range $i, $s := $servers }}{{ if $i }} {{ end }}https://{{ $s }}:{{ $.Parameters.dotdash_port }}{{ end }}
