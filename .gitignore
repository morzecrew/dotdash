# Key material never belongs in the repository.
*.key
*.pem

# The docs site's build output and toolchain.
pages/site/
pages/.cache/
pages/.venv/

# Python: the manager's environment and caches.
manager/.venv/
manager/dist/
__pycache__/
.pytest_cache/

# Local leftovers: core dumps, which may hold secrets, agents' worktrees, and
# research notes kept out of the public repository.
core.[0-9]*
.claude/worktrees/
docs/research/
