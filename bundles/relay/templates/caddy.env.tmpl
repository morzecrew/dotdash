{{- /* The own-site profile's Caddy (caddy/Caddyfile). An env file rather
than a mounted one, so a change re-creates Caddy at the next apply: Compose
hashes a service's environment, never the contents of a file it mounts. The
server groups are no longer here: a subscription goes through Xray by its
token's first 12 hex characters, which Xray routes to its group, so Caddy
restarts with none of their changes. */ -}}
{{- /* With cert_issuer=acme-dns, the wildcard over the relay's domain's parent,
so the one certificate Caddy takes keeps the domain itself out of the
Certificate Transparency logs; otherwise empty (caddy/Caddyfile). */ -}}
{{- $labels := split "." .Installation.Domain -}}
CERT_WILDCARD={{ if and (eq .Parameters.cert_issuer "acme-dns") (gt (len $labels) 2) }}*.{{ join (slice $labels 1) "." }}{{ end }}

{{- /* The http-origin profile's door (caddy/Caddyfile): http_origin_from as
Caddy's remote_ip takes it, space-separated; any is every address, and none
an address no one asks from (TEST-NET-1), so the door answers nobody. */ -}}
{{- $from := trim .Parameters.http_origin_from }}
HTTP_ORIGIN_FROM={{ if eq $from "any" }}0.0.0.0/0 ::/0{{ else if or (eq $from "none") (eq $from "") }}192.0.2.1/32{{ else }}{{ join (split "," $from) " " }}{{ end }}
