{{- /* REALITY's target: under the own-site profile the relay's own site,
Caddy, under the relay's own domain, whose DNS is this machine; otherwise the
borrowed site, whose DNS is someone else's. */ -}}
{{- $own := has "own-site" .Profiles -}}
{{- $kcp := has "mkcp" .Profiles -}}
{{- $site := .Parameters.site -}}
{{- if $own }}{{ $site = required "the own-site profile needs a domain: sudo morzer config set installation.domains=relay.example.net" .Installation.Domain }}
{{- else if eq $site "none" }}{{ $site = required "set site, a site next to the relay, or use the own-site profile with a domain of the relay's own" "" }}{{ end -}}
{{- $servers := split "," (required "set dotdash_servers" .Parameters.dotdash_servers) -}}
{{- $address := .Parameters.dotdash_address }}{{ if eq $address "none" }}{{ $address = "" }}{{ end -}}
{{- /* ipv6=block: an IPv6 destination ends here, in a blackhole after the
servers' outbounds (the first outbound stays the default); names go on. */ -}}
{{- $block6 := eq .Parameters.ipv6 "block" -}}
{{- $many := gt (len $servers) 1 -}}
{{- $pbk := required "set dotdash_public_key" .Parameters.dotdash_public_key -}}
{
  "log": {"loglevel": "warning", "access": "none"},
  "inbounds": [
    {
      "tag": "devices",
      "listen": "0.0.0.0",
      "port": 443,
      "protocol": "vless",
      "settings": {
        "clients": {"$vlessClients": "/run/secrets/vless_clients"},
        "flow": "xtls-rprx-vision",
        "decryption": {"$vlessDecryption": "/run/secrets/vless_seed"}
      },
      "streamSettings": {
        "network": "raw",
        "security": "reality",
        "realitySettings": {
          "target": "{{ if $own }}caddy{{ else }}{{ $site }}{{ end }}:443",
          "serverNames": ["{{ $site }}"],
          "privateKey": {"$file": "/run/secrets/reality_key"},
          "shortIds": [{"$file": "/run/secrets/reality_short_id"}]
        }
      }
    },
    {"tag": "probe", "listen": "127.0.0.1", "port": 10809, "protocol": "http"}
    {{- if $kcp }},
    {{- /* mKCP on UDP, published as kcp_port: the same devices, the same VLESS
    Encryption, on to dotdash like REALITY. AES-128-GCM under kcp_seed, then
    kcp_header, in that order, as devices' links name them. */}}
    {
      "tag": "devices-kcp",
      "listen": "0.0.0.0",
      "port": 8447,
      "protocol": "vless",
      "settings": {
        "clients": {"$vlessClients": "/run/secrets/vless_clients"},
        "decryption": {"$vlessDecryption": "/run/secrets/vless_seed"}
      },
      "streamSettings": {
        "network": "kcp",
        "finalmask": {"udp": [
          {"type": "mkcp-legacy", "settings": {"value": {"$file": "/run/secrets/kcp_seed"}}}
          {{- if ne .Parameters.kcp_header "none" }},
          {"type": "mkcp-legacy", "settings": {"header": "{{ .Parameters.kcp_header }}"}}
          {{- end }}
          {{- if eq .Parameters.kcp_open "quic" }},
          {"type": "noise", "settings": {"noise": [{"type": "hex", "packet": "c300000001088394c8f03e5157080000449e00000002", "delay": "0-0"}]}}
          {{- end }}
        ]}
      }
    }
    {{- end }}
    {{- if $own }},
    {{- /* XHTTP behind the relay's own site, which routes xhttp_path here
    over h2c, as the server's site does: the same devices, the same VLESS
    Encryption, on to dotdash like REALITY. On the project's network, never
    published. */}}
    {
      "tag": "devices-xhttp",
      "listen": "0.0.0.0",
      "port": 8080,
      "protocol": "vless",
      "settings": {
        "clients": {"$vlessClients": "/run/secrets/vless_clients"},
        "decryption": {"$vlessDecryption": "/run/secrets/vless_seed"}
      },
      "streamSettings": {
        "network": "xhttp",
        "xhttpSettings": {"path": {"$file": "/run/secrets/xhttp_path"}, "mode": "auto"}
      }
    },
    {{- /* Caddy's way to the dotdash servers, for devices' subscriptions:
    on the project's network, which nothing but Caddy shares, and never
    published. */}}
    {"tag": "subscriptions", "listen": "0.0.0.0", "port": 10810, "protocol": "http"}
    {{- end }}
  ],
  {{- /* One outbound per dotdash server, which share their keys. With
  several, a balancer takes whichever answers fastest, so a ban on one
  server's address doesn't cut every device off. */}}
  "outbounds": [
    {{- range $i, $s := $servers }}{{ if $i }},{{ end }}
    {
      "tag": "dotdash-{{ $i }}", "protocol": "vless",
      "settings": {
        "address": "{{ if and $address (eq (len $servers) 1) }}{{ $address }}{{ else }}{{ $s }}{{ end }}", "port": {{ $.Parameters.dotdash_port }},
        "id": {"$file": "/run/secrets/dotdash_id"},
        "encryption": {"$file": "/run/secrets/dotdash_encryption"},
        "flow": "xtls-rprx-vision"
      },
      "streamSettings": {"network": "raw", "security": "reality", "realitySettings": {
        "serverName": "{{ $s }}", "fingerprint": "chrome",
        "password": "{{ $pbk }}",
        "shortId": {"$file": "/run/secrets/dotdash_short_id"}
      }}
    }
    {{- end }}
    {{- if $block6 }},
    {"tag": "block", "protocol": "blackhole"}
    {{- end }}
  ]{{ if $many }},
  "observatory": {"subjectSelector": ["dotdash-"], "probeUrl": "{{ .Parameters.probe_url }}", "probeInterval": "30s", "enableConcurrency": true}
  {{- end }}{{ if or $many $block6 }},
  "routing": {
    {{- if $many }}
    "balancers": [{"tag": "dotdash", "selector": ["dotdash-"], "strategy": {"type": "leastPing"}}],
    {{- end }}
    "rules": [
      {{- if $block6 }}{"type": "field", "ip": ["::/0"], "outboundTag": "block"}{{ if $many }},{{ end }}{{ end }}
      {{- if $many }}{"type": "field", "network": "tcp,udp", "balancerTag": "dotdash"}{{ end }}
    ]
  }
  {{- end }}
}
