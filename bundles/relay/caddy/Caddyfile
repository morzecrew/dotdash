# The relay's own site (the own-site profile). Native expansion only: {$DOMAIN}
# from the environment when the Caddyfile is adapted.
#
# Port 443 here is reached only through Xray's REALITY inbound, which hands it
# every connection that does not carry the relay's key, so a prober meets this
# site, under a name whose DNS is this machine's. Port 80 is published
# directly, for the ACME HTTP-01 challenge and the redirect to HTTPS.
# Where the site's certificate comes from (the cert_issuer parameter), chosen
# by name below: Caddy has no conditional, and a snippet must be defined before
# the global options that import it.
# - acme: Let's Encrypt, over HTTP-01.
# - acme-dns: Let's Encrypt, over DNS-01 handed to an acme-dns server by the
#   CNAME at _acme-challenge (the acme_dns secret, its registration). With a
#   wildcard over the domain's parent (CERT_WILDCARD), which keeps the domain
#   itself out of the Certificate Transparency logs.
# - internal: Caddy's own CA, for a machine the internet cannot reach, such as
#   a CI rig.
(issuer-acme) {
	cert_issuer acme
}
(issuer-acme-dns) {
	cert_issuer acme
	acme_dns acmedns /run/secrets/acme_dns
}
(issuer-internal) {
	cert_issuer internal
}

{
	admin off
	# Errors only, and never the request they concern: its headers and
	# address identify whoever sent it. No access log either.
	log default {
		output stderr
		format filter {
			wrap json
			fields {
				request delete
			}
		}
		level ERROR
	}
	import issuer-{$CERT_ISSUER}
	# A CDN in front (cdn_hosts) may send its own name as SNI: answer with
	# this domain's certificate rather than none. A CDN that checks it against
	# its own name still fails; tell it to send this domain.
	fallback_sni {$DOMAIN}
	servers {
		protocols h1 h2
	}
}

# The container healthcheck's: loopback, plain HTTP, never published.
http://127.0.0.1:8081 {
	bind 127.0.0.1
	respond /healthz 200
}

# The http-origin profile's door: plain HTTP on 8091, which that profile
# alone publishes (http_origin_port), for a rented CDN that ends TLS at its
# own edge and fetches from here unencrypted. It answers only the addresses
# in http_origin_from (the CDN's gateways), and only on the CDN path, the
# one CDNs get in place of the site's XHTTP path above; everyone else gets
# a 404. That path goes on to Xray's plain XHTTP inbound under the site's
# path, so the CDN, which reads every request here, never learns that one,
# and VLESS Encryption keeps what the requests carry unreadable to it.
http://:8091 {
	@door {
		remote_ip {$HTTP_ORIGIN_FROM:192.0.2.1/32}
		path /{file./run/secrets/cdn_xhttp_path}/*
		# What follows the path: uri strip_prefix takes no placeholder.
		path_regexp door ^/[^/]+(/.*)$
	}
	handle @door {
		rewrite * /{file./run/secrets/xhttp_path}{re.door.1}?{query}
		reverse_proxy xray:8080 {
			header_up -X-Forwarded-For
			header_up -X-Forwarded-Host
			header_up -X-Forwarded-Proto
			header_up -X-Real-IP
			header_up -CF-Connecting-IP
			transport http {
				versions h2c
			}
			flush_interval -1
		}
	}
	respond 404
}

# A cover app's way to one host of its choosing (tunnel_host), as
# subscriptions go: through Xray's subscriptions inbound, so Caddy's TLS to
# the host rides inside the link to the dotdash servers, or to the relays
# this one goes through (via), and the network sees one TLS client from this
# machine, Xray's. Never published; the app reaches it on the edge network.
# Without tunnel_host, the site's 404.
http://:8090 {
	@tunnel expression "{$TUNNEL_HOST:none}" != "none"
	handle @tunnel {
		reverse_proxy {$TUNNEL_HOST:none}:443 {
			header_up Host {$TUNNEL_HOST:none}
			transport http {
				tls
				tls_server_name {$TUNNEL_HOST:none}
				network_proxy url http://xray:10810
			}
		}
	}
	respond 404
}

(headers) {
	header {
		-Server
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options nosniff
		Referrer-Policy no-referrer
	}
}

# The site, its routes and the XHTTP path: served under the relay's domain,
# and under any name a CDN in front sends as Host (below).
(site) {
	import headers
	handle_errors {
		import headers
	}

	# XHTTP: the secret path to Xray's XHTTP inbound, as the server's site
	# routes its own. h2c, so stream-up and stream-one survive, and no
	# buffering either way. The device's address stays here, as does the one
	# a CDN in front passes on in its own headers.
	@xhttp path /{file./run/secrets/xhttp_path}/*
	handle @xhttp {
		reverse_proxy xray:8080 {
			header_up -X-Forwarded-For
			header_up -X-Forwarded-Host
			header_up -X-Forwarded-Proto
			header_up -X-Real-IP
			header_up -CF-Connecting-IP
			transport http {
				versions h2c
			}
			flush_interval -1
		}
	}

	# XHTTP through a CDN in front (cdn_hosts): a path of its own, so the
	# CDN never learns the one above, to Xray's CDN inbound, which keeps the
	# session and sequence in cookies and so asks by this one path alone.
	@cdn path /{file./run/secrets/cdn_xhttp_path}
	handle @cdn {
		reverse_proxy xray:8082 {
			header_up -X-Forwarded-For
			header_up -X-Forwarded-Host
			header_up -X-Forwarded-Proto
			header_up -X-Real-IP
			header_up -CF-Connecting-IP
			transport http {
				versions h2c
			}
			flush_interval -1
		}
	}

	# A device's subscription, 32 hex characters as the server names it (and
	# with .json, its Xray config), fetched from the dotdash servers through this relay's own tunnel: Xray's
	# subscriptions inbound, which dotdash carries as it carries devices. A
	# device that reaches only this machine still refreshes its links, and
	# nothing between it and the server reads them. The first server that
	# answers serves it; the servers share their keys, so any has the file.
	# The device's address stays here. A request a CDN in front passed on,
	# which says so in one of these headers, gets the site's 404 instead, as
	# on the server: a device's links never pass through a CDN. So does one
	# under any name but this relay's domain, which a device always asks by:
	# a CDN that strips those headers is told apart by the Host it sends.
	@subscription {
		path_regexp ^/[0-9a-f]{32}(\.json)?$
		host {$DOMAIN}
		not header X-Forwarded-For *
		not header X-Forwarded-Host *
		not header X-Forwarded-Proto *
		not header Forwarded *
		not header X-Real-IP *
		not header True-Client-IP *
		not header Via *
		not header CDN-Loop *
	}
	handle @subscription {
		reverse_proxy {$SUBSCRIPTION_UPSTREAMS} {
			lb_policy first
			lb_try_duration 15s
			fail_duration 30s
			header_up -X-Forwarded-For
			header_up -X-Forwarded-Host
			header_up -X-Forwarded-Proto
			# Caddy adds Via to what it passes on, and the server serves a
			# subscription only to a request without one, as it tells a CDN's
			# from a device's: without this, it gave the relay its site.
			header_up -Via
			transport http {
				network_proxy url http://xray:10810
			}
		}
	}

	# The operator's own files wherever one is there; then their app (cover);
	# otherwise the bundled page, titled with the domain so no
	# two machines serve one body.
	@own file {
		root /srv/own
		try_files {path} {path}/index.html
	}
	handle @own {
		root * /srv/own
		file_server
	}
	# The operator's app (cover), for everything else: a live site, which a
	# probe or a reviewer finds behaving like one, rather than pages. Caddy
	# has no conditional, so the matcher compares the value as the Caddyfile
	# loads; with pages, the handler, whose upstream is then the word pages,
	# is never reached.
	@app expression `"{$COVER:pages}" != "pages"`
	handle @app {
		reverse_proxy {$COVER:pages}
	}
	handle {
		root * /srv/default
		templates
		file_server
	}
}

# CERT_WILDCARD, with cert_issuer=acme-dns, is the wildcard over the domain's
# parent: Caddy then takes that one certificate, and none in the domain's own
# name. Otherwise it is empty, and the certificate is the domain's.
{$DOMAIN} {$CERT_WILDCARD} {
	import site
}

# A CDN in front (cdn_hosts) passes devices' requests on with its own name as
# Host unless told to send the relay's domain: the same site under any name,
# so a CDN works on its defaults. The secret path, not the name, lets a
# device in.
https:// {
	import site
}
