# The relay's own site (the own-site profile). Native expansion only: {$DOMAIN}
# from the environment when the Caddyfile is adapted.
#
# Port 443 here is reached only through Xray's REALITY inbound, which hands it
# every connection that does not carry the relay's key, so a prober meets this
# site, under a name whose DNS is this machine's. Port 80 is published
# directly, for the ACME HTTP-01 challenge and the redirect to HTTPS.
{
	admin off
	# Errors only, and never the request they concern: its headers and
	# address identify whoever sent it. No access log either.
	log default {
		output stderr
		format filter {
			wrap json
			fields {
				request delete
			}
		}
		level ERROR
	}
	# acme: Let's Encrypt. internal: Caddy's own CA, for a machine the
	# internet cannot reach, such as a CI rig (the cert_issuer parameter).
	cert_issuer {$CERT_ISSUER}
	# A CDN in front (cdn_hosts) may send its own name as SNI: answer with
	# this domain's certificate rather than none. A CDN that checks it against
	# its own name still fails; tell it to send this domain.
	fallback_sni {$DOMAIN}
	servers {
		protocols h1 h2
	}
}

# The container healthcheck's: loopback, plain HTTP, never published.
http://127.0.0.1:8081 {
	bind 127.0.0.1
	respond /healthz 200
}

(headers) {
	header {
		-Server
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options nosniff
		Referrer-Policy no-referrer
	}
}

# The site, its routes and the XHTTP path: served under the relay's domain,
# and under any name a CDN in front sends as Host (below).
(site) {
	import headers
	handle_errors {
		import headers
	}

	# XHTTP: the secret path to Xray's XHTTP inbound, as the server's site
	# routes its own. h2c, so stream-up and stream-one survive, and no
	# buffering either way. The device's address stays here.
	@xhttp path /{file./run/secrets/xhttp_path}/*
	handle @xhttp {
		reverse_proxy xray:8080 {
			header_up -X-Forwarded-For
			header_up -X-Forwarded-Host
			header_up -X-Forwarded-Proto
			transport http {
				versions h2c
			}
			flush_interval -1
		}
	}

	# A device's subscription, 32 hex characters as the server names it,
	# fetched from the dotdash servers through this relay's own tunnel: Xray's
	# subscriptions inbound, which dotdash carries as it carries devices. A
	# device that reaches only this machine still refreshes its links, and
	# nothing between it and the server reads them. The first server that
	# answers serves it; the servers share their keys, so any has the file.
	# The device's address stays here. A request a CDN in front passed on,
	# which says so in one of these headers, gets the site's 404 instead, as
	# on the server: a device's links never pass through a CDN.
	@subscription {
		path_regexp ^/[0-9a-f]{32}$
		not header X-Forwarded-For *
		not header X-Forwarded-Host *
		not header X-Forwarded-Proto *
		not header Forwarded *
		not header X-Real-IP *
		not header True-Client-IP *
		not header Via *
		not header CDN-Loop *
	}
	handle @subscription {
		reverse_proxy {$SUBSCRIPTION_UPSTREAMS} {
			lb_policy first
			lb_try_duration 15s
			fail_duration 30s
			header_up -X-Forwarded-For
			header_up -X-Forwarded-Host
			header_up -X-Forwarded-Proto
			transport http {
				network_proxy url http://xray:10810
			}
		}
	}

	# The operator's site (site_dir) wherever it has the file; otherwise the
	# bundled page, titled with the domain so no two machines serve one body.
	@own file {
		root /srv/own
		try_files {path} {path}/index.html
	}
	handle @own {
		root * /srv/own
		file_server
	}
	handle {
		root * /srv/default
		templates
		file_server
	}
}

{$DOMAIN} {
	import site
}

# A CDN in front (cdn_hosts) passes devices' requests on with its own name as
# Host unless told to send the relay's domain: the same site under any name,
# so a CDN works on its defaults. The secret path, not the name, lets a
# device in.
https:// {
	import site
}
