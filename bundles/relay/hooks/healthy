#!/usr/bin/env bash
# Healthy when the relay's own machinery works: Xray runs, on the servers and
# via secrets it was given (a malformed line keeps it from starting), and the
# gateway's agent reached Xray's API in its last round, at most two minutes
# ago (the image's gateway-status). Not whether any server group answers:
# each group's state is the servers task's, the facts' and the metrics'
# (dotdash_group_live), so an idle relay with no servers line, or one whose
# groups are all down, is healthy, and a servers line a server doesn't take
# yet rolls no change back. Whether devices can reach this machine it cannot
# see; a canary can.
#
# After a start the agent's first round comes a second after Xray's, and
# takes up to 10 s for each server that doesn't answer, so the check waits
# up to 90 s for it, within its 2 minutes.
set -euo pipefail

project=${DOTDASH_RELAY_COMPOSE_PROJECT:-dotdash-relay}
docker compose -p "$project" ps --format '{{.Service}}' | grep -qx xray \
  || { echo "xray is not running: is a servers or via line malformed? docker logs names it" >&2; exit 1; }
for _ in $(seq 30); do
  if out=$(docker compose -p "$project" exec -T xray /usr/local/bin/xray-entrypoint gateway-status 2>&1); then
    # One line a group, and gateway: last round …; the groups' states alone.
    awk '$1 != "gateway:" && $1 != "dropped:" && NF >= 2 && $2 ~ /^(live|down|refused|starting)$/ { n++; s[$2]++ }
      END { if (!n) { print "the relay works, with no server group yet: it lets nobody in"; exit }
            printf "the relay works: %d server group(s)", n
            for (k in s) printf ", %d %s", s[k], k
            print "" }' <<<"$out"
    exit 0
  fi
  sleep 3
done
echo "the relay's gateway is not working: ${out##*$'\n'}" >&2
exit 1
