{{- /* Caddy's site names (caddy/Caddyfile). With cert_issuer=acme-dns,
CERT_WILDCARD is the wildcard over the domain's parent, *.r.example.net for
x7.r.example.net, so the one certificate Caddy takes keeps the domain itself out
of the Certificate Transparency logs; a domain of two labels has no parent to
take one over. Otherwise it is empty. An env file rather than a mounted one, so
a change re-creates Caddy at the next apply: Compose hashes a service's
environment, never the contents of a file it mounts. */ -}}
{{- $labels := split "." .Installation.Domain -}}
CERT_WILDCARD={{ if and (eq .Parameters.cert_issuer "acme-dns") (gt (len $labels) 2) }}*.{{ join (slice $labels 1) "." }}{{ end }}
