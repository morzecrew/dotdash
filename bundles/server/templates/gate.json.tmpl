{{- /*
The gate: the one container with a route out. Xray itself sits on internal
networks only, where a container can neither publish a port nor reach
anything beyond the other containers, so it cannot send traffic anywhere
directly whatever its config says. The gate carries what has to cross:

  - in: the public TLS port, and under their profiles UDP/53 for the DNS
    tunnel, xhttp_reality_port and kcp_port, to Xray, byte for byte
    (dokodemo-door);
  - out: Xray's SOCKS hop (1080), and under ipv6=separate a second one for
    IPv6 (1081), to the ways out the upstreams secret lists. Xray never holds
    them.

The ways out are not here: the gate's image turns the upstreams secret into
outbounds ({"$upstreams": ...}) in a file of their own (gate/upstreams.json),
whose outbounds Xray merges with these, routing kept from this file. In each
group, upstream and under ipv6=separate ipv6, the first line is tagged
<group>-0 and the rest <group>-b<n>, after upstream_pin moves a line to the
front (gate.env), so the balancers below select them by prefix without
knowing how many there are. The observatory probes every one at probe_url
every 30 s.

upstream_mode, per group:
  - failover: the first line while it answers. When it doesn't, the balancer
    falls back to a SOCKS hop into this gate (1090, 1091 for ipv6), whose own
    balancer takes the fastest of the rest; with no rest, or none answering,
    block. Two levels, not one per line: Xray's balancers have one fallback
    each, and leastLoad's cost weights overflow past ten or so;
  - fastest: whichever answers fastest (leastPing), the first line before any
    probe has answered;
  - balance: any line that answers, picked at random per connection; a line
    not yet probed counts as answering.
When nothing answers, a connection fails: nothing here leaves directly.

Nothing else is routed: the freedom outbound carries only the public inbounds,
whose destination is fixed to Xray, and everything else is blocked.
*/ -}}
{{- $withXdns := has "xdns" .Profiles -}}
{{- $xhttpReality := has "xhttp-reality" .Profiles -}}
{{- $kcp := has "mkcp" .Profiles -}}
{{- $v6 := eq .Parameters.ipv6 "separate" -}}
{{- $udp := eq (print .Parameters.upstream_udp) "true" -}}
{{- $mode := .Parameters.upstream_mode -}}
{{- /* Two services cannot publish one host port; refused here, so the apply
stops before anything is replaced. The template language has no fail: required
fails on its empty value with the message. */ -}}
{{- if $xhttpReality }}
{{- if eq .Parameters.xhttp_reality_port .Parameters.https_port }}{{ required "xhttp_reality_port must differ from https_port" "" }}{{ end }}
{{- if eq .Parameters.xhttp_reality_port "80" }}{{ required "xhttp_reality_port must not be 80, which Caddy publishes for ACME" "" }}{{ end }}
{{- end }}
{{- if and $kcp $withXdns (eq .Parameters.kcp_port "53") }}{{ required "kcp_port must not be 53, which the DNS tunnel publishes" "" }}{{ end }}
{
  "log": {"loglevel": "{{ .Parameters.log_level }}", "access": "none", "dnsLog": false},
  "inbounds": [
    {"tag": "public-tls", "listen": "0.0.0.0", "port": 443, "protocol": "dokodemo-door",
     "settings": {"address": "xray", "port": 443, "network": "tcp"}},
{{- if $withXdns }}
    {"tag": "public-dns", "listen": "0.0.0.0", "port": 5353, "protocol": "dokodemo-door",
     "settings": {"address": "xray", "port": 5353, "network": "udp"}},
{{- end }}
{{- if $xhttpReality }}
    {"tag": "public-xhttp-reality", "listen": "0.0.0.0", "port": 8443, "protocol": "dokodemo-door",
     "settings": {"address": "xray", "port": 8443, "network": "tcp"}},
{{- end }}
{{- if $kcp }}
    {"tag": "public-kcp", "listen": "0.0.0.0", "port": 8447, "protocol": "dokodemo-door",
     "settings": {"address": "xray", "port": 8447, "network": "udp"}},
{{- end }}
{{- if eq $mode "failover" }}
    {"tag": "backups", "listen": "127.0.0.1", "port": 1090, "protocol": "socks",
     "settings": {"auth": "noauth", "udp": {{ $udp }}}},
{{- if $v6 }}
    {"tag": "backups6", "listen": "127.0.0.1", "port": 1091, "protocol": "socks",
     "settings": {"auth": "noauth", "udp": false}},
{{- end }}
{{- end }}
    {"tag": "egress", "listen": "0.0.0.0", "port": 1080, "protocol": "socks",
     "settings": {"auth": "noauth", "udp": {{ $udp }}}}
{{- if $v6 }},
    {"tag": "egress6", "listen": "0.0.0.0", "port": 1081, "protocol": "socks",
     "settings": {"auth": "noauth", "udp": false}}
{{- end }}
  ],
  "outbounds": [
    {"tag": "block", "protocol": "blackhole"},
    {"tag": "inside", "protocol": "freedom"}
{{- if eq $mode "failover" }},
    {"tag": "to-backups", "protocol": "socks", "settings": {"address": "127.0.0.1", "port": 1090}}
{{- if $v6 }},
    {"tag": "to-backups6", "protocol": "socks", "settings": {"address": "127.0.0.1", "port": 1091}}
{{- end }}
{{- end }}
  ],
  "observatory": {"subjectSelector": ["upstream-"{{ if $v6 }}, "ipv6-"{{ end }}], "probeUrl": "{{ .Parameters.probe_url }}", "probeInterval": "30s", "enableConcurrency": true},
  "routing": {
    "domainStrategy": "AsIs",
    "balancers": [
{{- if eq $mode "failover" }}
      {"tag": "egress", "selector": ["upstream-0"], "strategy": {"type": "random"}, "fallbackTag": "to-backups"},
      {"tag": "backups", "selector": ["upstream-b"], "strategy": {"type": "leastPing"}, "fallbackTag": "block"}
{{- if $v6 }},
      {"tag": "egress6", "selector": ["ipv6-0"], "strategy": {"type": "random"}, "fallbackTag": "to-backups6"},
      {"tag": "backups6", "selector": ["ipv6-b"], "strategy": {"type": "leastPing"}, "fallbackTag": "block"}
{{- end }}
{{- else if eq $mode "fastest" }}
      {"tag": "egress", "selector": ["upstream-"], "strategy": {"type": "leastPing"}, "fallbackTag": "upstream-0"}
{{- if $v6 }},
      {"tag": "egress6", "selector": ["ipv6-"], "strategy": {"type": "leastPing"}, "fallbackTag": "ipv6-0"}
{{- end }}
{{- else }}
      {"tag": "egress", "selector": ["upstream-"], "strategy": {"type": "random"}, "fallbackTag": "block"}
{{- if $v6 }},
      {"tag": "egress6", "selector": ["ipv6-"], "strategy": {"type": "random"}, "fallbackTag": "block"}
{{- end }}
{{- end }}
    ],
    "rules": [
      {"inboundTag": ["public-tls"{{ if $withXdns }}, "public-dns"{{ end }}{{ if $xhttpReality }}, "public-xhttp-reality"{{ end }}{{ if $kcp }}, "public-kcp"{{ end }}], "outboundTag": "inside"},
      {"inboundTag": ["egress"], "balancerTag": "egress"},
{{- if eq $mode "failover" }}
      {"inboundTag": ["backups"], "balancerTag": "backups"},
{{- end }}
{{- if $v6 }}
      {"inboundTag": ["egress6"], "balancerTag": "egress6"},
{{- if eq $mode "failover" }}
      {"inboundTag": ["backups6"], "balancerTag": "backups6"},
{{- end }}
{{- end }}
      {"network": "tcp,udp", "outboundTag": "block"}
    ]
  }
}
