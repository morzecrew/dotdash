{{- /* What the gate's image reads for the upstreams secret ({"$upstreams": ...},
gate.json.tmpl): the lines upstream_pin moves to the front of their groups, and
the hop an openvpn:// line stands for, the k-th at vpn:1080+k, the SOCKS hop in
the OpenVPN client's namespace (compose/openvpn.yaml). Defined with the
openvpn profile off too, so a line can be added before the profile is turned
on, which needs one: until then the line leads nowhere and the others carry
the traffic. */ -}}
XRAY_UPSTREAM_PIN={{ if ne .Parameters.upstream_pin "none" }}{{ .Parameters.upstream_pin }}{{ end }}
XRAY_UPSTREAM_ALIASES=openvpn=socks5://vpn:1080
