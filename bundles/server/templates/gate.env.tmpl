{{- /* What the gate's image reads for the upstreams secret ({"$upstreams": ...},
gate.json.tmpl): the lines upstream_pin moves to the front of their groups, and
under the openvpn profile the word an `openvpn` line stands for, the SOCKS hop
in the OpenVPN client's namespace (compose/openvpn.yaml). */ -}}
XRAY_UPSTREAM_PIN={{ if ne .Parameters.upstream_pin "none" }}{{ .Parameters.upstream_pin }}{{ end }}
XRAY_UPSTREAM_ALIASES={{ if has "openvpn" .Profiles }}openvpn=socks5://vpn:1080{{ end }}
