# dotdash cover site. Native expansion only: {$DOMAIN} from the environment
# when the Caddyfile is adapted, {file.*} from the secret files on each request.
#
# Port 443 here is reached only through Xray's REALITY inbound, which relays
# every connection that does not carry its key. Port 80 is published directly,
# as http_port, for the ACME HTTP-01 challenge and the redirect to HTTPS.
# Where the site's certificate comes from (the cert_issuer parameter), chosen
# by name below: Caddy has no conditional, and a snippet must be defined before
# the global options that import it.
# - acme: Let's Encrypt, over HTTP-01.
# - acme-dns: Let's Encrypt, over DNS-01 handed to an acme-dns server by the
#   CNAME at _acme-challenge (the acme_dns secret, its registration). With a
#   wildcard over the domain's parent (CERT_WILDCARD), which keeps the domain
#   itself out of the Certificate Transparency logs.
# - internal: Caddy's own CA, for a machine the internet cannot reach, such as
#   a CI rig.
(issuer-acme) {
	cert_issuer acme
}
(issuer-acme-dns) {
	cert_issuer acme
	acme_dns acmedns /run/secrets/acme_dns
}
(issuer-internal) {
	cert_issuer internal
}

{
	admin off
	# Errors only, and never the request they concern: its URI carries the
	# XHTTP path, a secret, and its headers and address identify the client.
	# No access log either.
	log default {
		output stderr
		format filter {
			wrap json
			fields {
				request delete
			}
		}
		level ERROR
	}
	import issuer-{$CERT_ISSUER}
	# A CDN in front may send its own name as SNI: answer with this domain's
	# certificate rather than none. A CDN that checks the origin's certificate
	# against its own name still fails; tell it to send this domain.
	fallback_sni {$DOMAIN}
	# The redirect to HTTPS is the http:// site's, for every name.
	auto_https disable_redirects
	# On 443, a connection from XRAY_NET, the backend network Caddy shares
	# with Xray alone (caddy/start.sh), may open with a PROXY header naming
	# the visitor Xray relays, which the cover app then gets as
	# X-Forwarded-For. Hysteria2's masquerade sends none, and is taken as
	# Xray's own address. A header from anywhere else is read and ignored.
	# The first servers block that names a server's address is the one it
	# takes.
	servers :443 {
		listener_wrappers {
			proxy_protocol {
				allow {$XRAY_NET}
			}
			tls
		}
		protocols h1 h2
	}
	servers {
		protocols h1 h2
	}
}

# The container healthcheck's: loopback, plain HTTP, never published.
http://127.0.0.1:8081 {
	bind 127.0.0.1
	respond /healthz 200
}

# On every answer, errors too: those skip the site's own routes, so without
# handle_errors a 404 or 405 would name the server and drop the rest. The
# Via that reverse_proxy adds to an app's answers names Caddy as Server
# would; a deletion waits until the answer is written, so it goes too.
(headers) {
	header {
		-Server
		-Via
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options nosniff
		Referrer-Policy no-referrer
	}
}

# The site, its routes and the XHTTP path: served under this domain, and
# under any name a CDN in front sends as Host (below).
(site) {
	import headers
	handle_errors {
		import headers
	}

	# A device's subscription (the subscription parameter): 32 hex characters
	# naming a file the subscription service wrote, its links, and the same
	# with .json, its Xray config, for a client that runs Xray itself (as
	# dotdash-client does) rather than turning links into one. Any other path, a guessed
	# one included, gets the site and its 404. So does a request a CDN or any
	# other proxy passed on, which says so in one of these headers: a device
	# asks this site, or an own-site relay that strips its own, so its links
	# never pass through a CDN, which could read them. cdn-check tells whether
	# a CDN is refused.
	@subscription {
		path_regexp ^/[0-9a-f]{32}(\.json)?$
		not header X-Forwarded-For *
		not header X-Forwarded-Host *
		not header X-Forwarded-Proto *
		not header Forwarded *
		not header X-Real-IP *
		not header True-Client-IP *
		not header Via *
		not header CDN-Loop *
		file {
			root /srv/sub
			try_files {path}
		}
	}
	handle @subscription {
		root * /srv/sub
		# no-store: neither a CDN nor a relay keeps a copy, which would outlive
		# a revocation and hold every link.
		# Asked for exactly as JSON, as dotdash-client's Xray asks, the URL
		# serves the Xray config, so a device's one URL does for an app and for
		# dotdash-client alike. An app asks for */* or nothing, and gets links.
		@json {
			path_regexp ^/[0-9a-f]{32}$
			header Accept application/json
		}
		rewrite @json {path}.json
		# The links as the apps read them; the .json goes as JSON, by its name.
		@links {
			path_regexp ^/[0-9a-f]{32}$
			not header Accept application/json
		}
		header @links Content-Type "text/plain; charset=utf-8"
		# An app on Apple's network stack, by its User-Agent, gets the links
		# with Safari's hello (subscription.sh), as its platform's own: a
		# Chrome hello from an iPhone fits neither its TCP nor its browser.
		@apple {
			path_regexp ^/[0-9a-f]{32}$
			not header Accept application/json
			header_regexp User-Agent (?i)(cfnetwork|darwin|iphone|ipad|ios|macintosh)
		}
		rewrite @apple {path}.apple
		# The subscription's name in the apps that show one (Happ, Hiddify):
		# this server's exit, its country's flag and IPv4, in place of this
		# domain, once exit-title has written it.
		@titled {
			path_regexp ^/[0-9a-f]{32}$
			file {
				root /srv/exit
				try_files /title
			}
		}
		header @titled Profile-Title "base64:{file./srv/exit/title}"
		# How often the apps that read it (Happ, Hiddify) fetch it
		# again, in hours: a new relay, a rotated key or a revoked device
		# reaches them within that, where an app left alone may never refetch.
		header Profile-Update-Interval 6
		# Happ's routing profile (happ_routing), while subscription.sh has
		# written one: Happ adds it and turns it on, and takes it again with
		# every refresh. Other apps ignore the header.
		@routed file {
			root /srv/sub
			try_files /.routing
		}
		header @routed Routing "happ://routing/onadd/{file./srv/sub/.routing}"
		header Cache-Control no-store
		file_server
	}

	@xhttp path /{file./run/secrets/xhttp_path}/*
	handle @xhttp {
		# h2c so XHTTP stream-up/stream-one survive; no buffering either way.
		reverse_proxy xray:8080 {
			# Xray needs no client addresses; keep them out of it.
			header_up -X-Forwarded-For
			header_up -X-Real-IP
			header_up -CF-Connecting-IP
			transport http {
				versions h2c
			}
			flush_interval -1
		}
	}

	# The operator's own files wherever one is there; then their app (cover);
	# otherwise the bundled page, titled with the domain so no
	# two servers serve one body.
	@own file {
		root /srv/own
		try_files {path} {path}/index.html
	}
	handle @own {
		root * /srv/own
		file_server
	}
	# The operator's app (cover), for everything else: a live site, which a
	# probe or a reviewer finds behaving like one, rather than pages. Caddy
	# has no conditional, so the matcher compares the value as the Caddyfile
	# loads; with pages, the handler, whose upstream is then the word pages,
	# is never reached.
	@app expression `"{$COVER:pages}" != "pages"`
	handle @app {
		reverse_proxy {$COVER:pages}
	}
	handle {
		root * /srv/default
		templates
		file_server
	}
}

# CERT_WILDCARD, with cert_issuer=acme-dns, is the wildcard over the domain's
# parent: Caddy then takes that one certificate, and none in the domain's own
# name. Otherwise it is empty, and the certificate is the domain's.
{$DOMAIN} {$CERT_WILDCARD} {
	import site
}

# A CDN in front (cdn_hosts) passes devices' requests on with its own name as
# Host unless told to send this domain: the same site under any name, so a
# CDN works on its defaults. The secret path, not the name, lets a device in.
https:// {
	import site
}

# Port 80 (http_port): the redirect to HTTPS Caddy makes of its own, the same
# 308, Location and closed connection, but naming no server. The ACME check
# is answered before any site, as it was.
http:// {
	header -Server
	header Location https://{host}{uri}
	respond 308 {
		close
	}
}
