# dotdash cover site. Native expansion only: {$DOMAIN} from the environment
# when the Caddyfile is adapted, {file.*} from the secret files on each request.
#
# Port 443 here is reached only through Xray's REALITY inbound, which relays
# every connection that does not carry its key. Port 80 is published directly,
# for the ACME HTTP-01 challenge and the redirect to HTTPS.
{
	admin off
	# Errors only, and never the request they concern: its URI carries the
	# XHTTP path, a secret, and its headers and address identify the client.
	# No access log either.
	log default {
		output stderr
		format filter {
			wrap json
			fields {
				request delete
			}
		}
		level ERROR
	}
	# acme: Let's Encrypt. internal: Caddy's own CA, for a machine the
	# internet cannot reach, such as a CI rig (the cert_issuer parameter).
	cert_issuer {$CERT_ISSUER}
	# A CDN in front may send its own name as SNI: answer with this domain's
	# certificate rather than none. A CDN that checks the origin's certificate
	# against its own name still fails; tell it to send this domain.
	fallback_sni {$DOMAIN}
	servers {
		protocols h1 h2
	}
}

# The container healthcheck's: loopback, plain HTTP, never published.
http://127.0.0.1:8081 {
	bind 127.0.0.1
	respond /healthz 200
}

# On every answer, errors too: those skip the site's own routes, so without
# handle_errors a 404 or 405 would name the server and drop the rest.
(headers) {
	header {
		-Server
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options nosniff
		Referrer-Policy no-referrer
	}
}

# The site, its routes and the XHTTP path: served under this domain, and
# under any name a CDN in front sends as Host (below).
(site) {
	import headers
	handle_errors {
		import headers
	}

	# A device's subscription (the subscription parameter): 32 hex characters
	# naming a file the subscription service wrote. Any other path, a guessed
	# one included, gets the site and its 404. So does a request a CDN or any
	# other proxy passed on, which says so in one of these headers: a device
	# asks this site, or an own-site relay that strips its own, so its links
	# never pass through a CDN, which could read them. cdn-check tells whether
	# a CDN is refused.
	@subscription {
		path_regexp ^/[0-9a-f]{32}$
		not header X-Forwarded-For *
		not header X-Forwarded-Host *
		not header X-Forwarded-Proto *
		not header Forwarded *
		not header X-Real-IP *
		not header True-Client-IP *
		not header Via *
		not header CDN-Loop *
		file {
			root /srv/sub
			try_files {path}
		}
	}
	handle @subscription {
		root * /srv/sub
		# no-store: neither a CDN nor a relay keeps a copy, which would outlive
		# a revocation and hold every link.
		header Content-Type "text/plain; charset=utf-8"
		header Cache-Control no-store
		file_server
	}

	@xhttp path /{file./run/secrets/xhttp_path}/*
	handle @xhttp {
		# h2c so XHTTP stream-up/stream-one survive; no buffering either way.
		reverse_proxy xray:8080 {
			# Xray needs no client addresses; keep them out of it.
			header_up -X-Forwarded-For
			header_up -X-Real-IP
			header_up -CF-Connecting-IP
			transport http {
				versions h2c
			}
			flush_interval -1
		}
	}

	# The operator's own files wherever one is there; then their app (cover);
	# otherwise the bundled page, titled with the domain so no
	# two servers serve one body.
	@own file {
		root /srv/own
		try_files {path} {path}/index.html
	}
	handle @own {
		root * /srv/own
		file_server
	}
	# The operator's app (cover), for everything else: a live site, which a
	# probe or a reviewer finds behaving like one, rather than pages. Caddy
	# has no conditional, so the matcher compares the value as the Caddyfile
	# loads; with pages, the handler, whose upstream is then the word pages,
	# is never reached.
	@app expression `"{$COVER:pages}" != "pages"`
	handle @app {
		reverse_proxy {$COVER:pages}
	}
	handle {
		root * /srv/default
		templates
		file_server
	}
}

{$DOMAIN} {
	import site
}

# A CDN in front (cdn_hosts) passes devices' requests on with its own name as
# Host unless told to send this domain: the same site under any name, so a
# CDN works on its defaults. The secret path, not the name, lets a device in.
https:// {
	import site
}
