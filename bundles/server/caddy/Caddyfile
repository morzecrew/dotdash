# dotdash cover site. Native expansion only: {$DOMAIN} from the environment
# when the Caddyfile is adapted, {file.*} from the secret files on each request.
#
# Port 443 here is reached only through Xray's REALITY inbound, which relays
# every connection that does not carry its key. Port 80 is published directly,
# for the ACME HTTP-01 challenge and the redirect to HTTPS.
# Where the site's certificate comes from (the cert_issuer parameter), chosen
# by name below: Caddy has no conditional, and a snippet must be defined before
# the global options that import it.
# - acme: Let's Encrypt, over HTTP-01.
# - acme-dns: Let's Encrypt, over DNS-01 handed to an acme-dns server by the
#   CNAME at _acme-challenge (the acme_dns secret, its registration). With a
#   wildcard over the domain's parent (CERT_WILDCARD), which keeps the domain
#   itself out of the Certificate Transparency logs.
# - internal: Caddy's own CA, for a machine the internet cannot reach, such as
#   a CI rig.
(issuer-acme) {
	cert_issuer acme
}
(issuer-acme-dns) {
	cert_issuer acme
	acme_dns acmedns /run/secrets/acme_dns
}
(issuer-internal) {
	cert_issuer internal
}

{
	admin off
	# Errors only, and never the request they concern: its URI carries the
	# XHTTP path, a secret, and its headers and address identify the client.
	# No access log either.
	log default {
		output stderr
		format filter {
			wrap json
			fields {
				request delete
			}
		}
		level ERROR
	}
	import issuer-{$CERT_ISSUER}
	# A CDN in front may send its own name as SNI: answer with this domain's
	# certificate rather than none. A CDN that checks the origin's certificate
	# against its own name still fails; tell it to send this domain.
	fallback_sni {$DOMAIN}
	servers {
		protocols h1 h2
	}
}

# The container healthcheck's: loopback, plain HTTP, never published.
http://127.0.0.1:8081 {
	bind 127.0.0.1
	respond /healthz 200
}

# On every answer, errors too: those skip the site's own routes, so without
# handle_errors a 404 or 405 would name the server and drop the rest.
(headers) {
	header {
		-Server
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options nosniff
		Referrer-Policy no-referrer
	}
}

# The site, its routes and the XHTTP path: served under this domain, and
# under any name a CDN in front sends as Host (below).
(site) {
	import headers
	handle_errors {
		import headers
	}

	# A device's subscription (the subscription parameter): 32 hex characters
	# naming a file the subscription service wrote. Any other path, a guessed
	# one included, gets the site and its 404.
	@subscription {
		path_regexp ^/[0-9a-f]{32}$
		file {
			root /srv/sub
			try_files {path}
		}
	}
	handle @subscription {
		root * /srv/sub
		# no-store: neither a CDN nor a relay keeps a copy, which would outlive
		# a revocation and hold every link.
		header Content-Type "text/plain; charset=utf-8"
		header Cache-Control no-store
		file_server
	}

	@xhttp path /{file./run/secrets/xhttp_path}/*
	handle @xhttp {
		# h2c so XHTTP stream-up/stream-one survive; no buffering either way.
		reverse_proxy xray:8080 {
			# Xray needs no client addresses; keep them out of it.
			header_up -X-Forwarded-For
			header_up -X-Real-IP
			header_up -CF-Connecting-IP
			transport http {
				versions h2c
			}
			flush_interval -1
		}
	}

	# The operator's site (site_dir) wherever it has the file; otherwise the
	# bundled page, titled with the domain so no two servers serve one body.
	@own file {
		root /srv/own
		try_files {path} {path}/index.html
	}
	handle @own {
		root * /srv/own
		file_server
	}
	handle {
		root * /srv/default
		templates
		file_server
	}
}

# CERT_WILDCARD, with cert_issuer=acme-dns, is the wildcard over the domain's
# parent: Caddy then takes that one certificate, and none in the domain's own
# name. Otherwise it is empty, and the certificate is the domain's.
{$DOMAIN} {$CERT_WILDCARD} {
	import site
}

# A CDN in front (cdn_hosts) passes devices' requests on with its own name as
# Host unless told to send this domain: the same site under any name, so a
# CDN works on its defaults. The secret path, not the name, lets a device in.
https:// {
	import site
}
