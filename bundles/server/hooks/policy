#!/usr/bin/env bash
# The release's invariants, checked against what actually runs rather than the
# templates that should produce it:
#
#   - Xray's traffic leaves through the upstream only: two outbounds, the
#     upstream (a SOCKS hop to the gate, with no credentials) and block, and
#     with ipv6=separate a third, upstream6, the same hop to the gate's IPv6
#     egress; no freedom anywhere, and the upstream the explicit last rule;
#   - names are resolved either by the upstream (no DNS in Xray, names passed
#     on), or here over DoH routed through the upstream, with the upstream
#     handed addresses only (ForceIP, never UseIP's fallback to the name);
#   - every VLESS inbound demands a listed client and VLESS decryption, no
#     XHTTP inbound sets a flow, and anything else listens on loopback only;
#   - the gate forwards its public inbounds to Xray only, carries Xray's hops
#     to the upstreams lines alone, through balancers that pick among those
#     lines and nothing else, and blocks everything else; its upstreams file
#     is the release's own, and the list holds what its settings need;
#   - Xray is on internal networks only, so it has no route out at all, and
#     publishes nothing; the gate publishes only https_port and, where it
#     forwards them, 53 for the DNS tunnel, xhttp_reality_port and kcp_port,
#     and Caddy only 80;
#   - every container runs unprivileged: no added capability, read-only, uid
#     65532, not on the host's network.
#
# smoke_test runs it after every apply and update, so a release that breaks
# one is rolled back; `doctor` runs it as a fatal preflight, so drift notifies.
# It prints each violation and exits 1. The rendered config is read with jq
# from its own image, pinned in the manifest and run with no network, so the
# host needs no jq.
set -euo pipefail

# As a preflight it checks what runs, which an operation is about to replace:
# only `doctor` asks it there. Exit 2 is "not applicable".
if [ "${DOTDASH_PHASE:-}" = preflight ] && [ "${DOTDASH_OPERATION_TYPE:-}" != doctor ]; then
  exit 2
fi

project=${DOTDASH_COMPOSE_PROJECT:-dotdash}
config=${DOTDASH_CONFIG_FILE:-/etc/dotdash/application.yaml}
gate=${DOTDASH_GATE_CONFIG:-/etc/dotdash/gate.json}
release=${DOTDASH_RELEASE_DIR:?}
https_port=${DOTDASH_PARAM_HTTPS_PORT:-443}
xhttp_reality_port=${DOTDASH_PARAM_XHTTP_REALITY_PORT:-8443}
kcp_port=${DOTDASH_PARAM_KCP_PORT:-8447}
jq_image=$(sed -n 's/^  jq: *//p' "${release}/manifest.yaml")
[ -n "${jq_image}" ] || { echo "policy: the release pins no jq image" >&2; exit 1; }
docker image inspect "${jq_image}" >/dev/null 2>&1 || docker pull -q "${jq_image}" >/dev/null

jq() { # <filter> <file>: the filter's output, or why the file does not parse
  docker run --rm -i --network none --read-only --cap-drop ALL --user 65532:65532 \
    "${jq_image}" -r "def check(\$ok; \$what): if \$ok then empty else \$what end; $1" <"$2" 2>&1 ||
    echo "$2 does not parse"
}

violations=$(jq '
  [.outbounds[]?.tag] as $tags
  | ([.inbounds[]?.tag] - ["reality", "xhttp", "xhttp-reality", "kcp", "xdns", "probe"]) as $extra
  | check($tags == ["upstream", "block"] or $tags == ["upstream", "block", "upstream6"];
      "the outbounds are \($tags), not upstream and block (and upstream6)"),
    (.outbounds[2]? // empty |
      check(.protocol == "socks" and .settings.address == "gate" and .settings.port == 1081 and .settings.user == null;
        "the upstream6 outbound is not a SOCKS hop to the gate'"'"'s IPv6 egress without credentials")),
    check(.outbounds[0] | .protocol == "socks" and .settings.address == "gate" and .settings.user == null;
      "the upstream outbound is not a SOCKS hop to the gate without credentials"),
    check(.outbounds[1].protocol == "blackhole"; "the block outbound is not a blackhole"),
    check([.. | objects | .protocol? // empty] | index("freedom") == null; "a freedom outbound sends traffic out directly"),
    ((.outbounds[0].targetStrategy // "AsIs") | ascii_downcase) as $target
    | (if has("dns") then
        # resolve=gateway: DoH only, routed (not "+local"), and the upstream
        # handed addresses only, never the name as a fallback.
        check([.dns.servers[]? | if type == "string" then . else .address end] as $s
          | ($s | length) > 0 and ($s | all(startswith("https://")));
          "Xray asks DNS other than DoH through the upstream (\([.dns.servers[]? | if type == "string" then . else .address end]))"),
        check($target | startswith("forceip");
          "Xray resolves names, but the upstream outbound can still hand it a name (targetStrategy \($target))"),
        (.outbounds[2]? // empty | (.targetStrategy // "AsIs" | ascii_downcase) |
          check(. == "forceipv6"; "the upstream6 outbound can hand the IPv6 proxy a name or an IPv4 address (targetStrategy \(.))"))
      else
        # resolve=upstream: names go to the upstream as they are.
        check((.routing.domainStrategy // "AsIs") == "AsIs"; "Xray resolves names with no DNS of its own (domainStrategy \(.routing.domainStrategy))"),
        check($target == "asis"; "the upstream outbound resolves names with no DNS of Xray'"'"'s own (targetStrategy \($target))")
      end),
    check(.routing.rules[-1] == {network: "tcp,udp", outboundTag: "upstream"}; "the last routing rule does not name the upstream"),
    check($extra == []; "unexpected inbounds: \($extra)"),
    (.inbounds[]? | select(.protocol == "vless") |
      check(.settings.clients != null; "inbound \(.tag) accepts no client list"),
      check(.settings.decryption != null and .settings.decryption != "none"; "inbound \(.tag) has no VLESS decryption"),
      check(.streamSettings.network != "xhttp" or .settings.flow == null; "inbound \(.tag) sets a flow on XHTTP")),
    (.inbounds[]? | select(.protocol != "vless") |
      check(.listen == "127.0.0.1"; "inbound \(.tag) (\(.protocol)) listens beyond loopback"))
  ' "${config}")
violations+=$'\n'$(jq '
  ["public-tls", "public-dns", "public-xhttp-reality", "public-kcp"] as $public
  | ["egress", "egress6", "backups", "backups6"] as $hops
  | ([.inbounds[]?.tag] - $public - $hops) as $extra
  | [.routing.rules[]? | select(.outboundTag == "inside") | .inboundTag // ["(any)"] | .[]] as $inward
  | check($extra == []; "the gate has unexpected inbounds: \($extra)"),
    (.inbounds[]? | select(.protocol == "dokodemo-door") |
      check(.settings.address == "xray"; "the gate forwards \(.tag) to \(.settings.address), not Xray")),
    (.inbounds[]? | select(.tag | IN("backups", "backups6")) |
      check(.listen == "127.0.0.1"; "the gate'"'"'s \(.tag) hop listens beyond loopback")),
    # Its own outbounds: block, inside, and the hops into its backups balancers.
    # The upstreams lines come from the upstreams file, which the image turns
    # into socks, http and wireguard outbounds only (noKernelTun always).
    check([.outbounds[]?.tag] | .[0:2] == ["block", "inside"] and IN(.[2:]; [], ["to-backups"], ["to-backups", "to-backups6"]);
      "the gate'"'"'s outbounds are \([.outbounds[]?.tag])"),
    check(.outbounds[0].protocol == "blackhole"; "the gate'"'"'s block outbound is not a blackhole"),
    (.outbounds[]? | select(.tag | IN("to-backups", "to-backups6")) |
      check(.protocol == "socks" and .settings.address == "127.0.0.1" and .settings.user == null and
            .settings.port == (if .tag == "to-backups" then 1090 else 1091 end);
        "the gate'"'"'s \(.tag) is not a hop into its own backups inbound")),
    # Balancers pick upstreams lines alone, and fall back to a line, a hop or block.
    (.routing.balancers // [])[] as $b
    | check(($b.selector | length) > 0 and ($b.selector | all(test("^(upstream|ipv6)-(0|b)?$")));
        "the gate'"'"'s balancer \($b.tag) selects \($b.selector), not upstreams lines"),
      check($b.fallbackTag | IN("block", "to-backups", "to-backups6", "upstream-0", "ipv6-0");
        "the gate'"'"'s balancer \($b.tag) falls back to \($b.fallbackTag)"),
    (.routing.rules[]? | select(.balancerTag != null) |
      check(.inboundTag != null and (.inboundTag - $hops) == [];
        "the gate sends \(.inboundTag // ["(any)"]) through a balancer")),
    check([.routing.rules[]? | .outboundTag // empty] - ["inside", "block"] == [];
      "the gate routes straight to \([.routing.rules[]? | .outboundTag // empty] - ["inside", "block"])"),
    check(($inward - $public) == []; "the gate sends \($inward - $public) out directly"),
    check(.routing.rules[-1] == {network: "tcp,udp", outboundTag: "block"}; "the gate does not block what its rules leave"),
    check(has("dns") | not; "the gate has a DNS section of its own")
  ' "${gate}")
want='{"outbounds": {"$upstreams": "/run/secrets/upstreams"}}'
[ "$(cat "${release}/gate/upstreams.json" 2>/dev/null)" = "${want}" ] ||
  violations+=$'\n'"the gate's upstreams file is not the release's own"

# The list against the settings that read it. Only what each line is, never a
# URL, goes into a message: the file holds credentials.
upstreams=${DOTDASH_SECRETS_DIR:-/run/dotdash/secrets}/upstreams
if [ -r "${upstreams}" ]; then
  tunnels=0 v4=0 v6=0
  while read -r url opts || [ -n "${url:-}" ]; do
    case ${url} in '' | '#'*) continue ;; esac
    case ${url} in wireguard://* | openvpn) tunnels=$((tunnels + 1)) ;; esac
    groups=upstream
    for o in ${opts}; do case ${o} in group=*) groups=${o#group=} ;; esac; done
    case ",${groups}," in *,upstream,*) v4=$((v4 + 1)) ;; esac
    case ",${groups}," in *,ipv6,*) v6=$((v6 + 1)) ;; esac
  done <"${upstreams}"
  [ "${v4}" -gt 0 ] || violations+=$'\n'"no upstreams line is in the upstream group, which carries everything but IPv6"
  if [ "${DOTDASH_PARAM_RESOLVE:-gateway}" = upstream ] && [ "${tunnels}" -gt 0 ]; then
    violations+=$'\n'"resolve=upstream, but ${tunnels} upstreams line(s) are a WireGuard or OpenVPN tunnel, which resolves no names"
  fi
  if [ "${DOTDASH_PARAM_IPV6:-allow}" = separate ] && [ "${v6}" = 0 ]; then
    violations+=$'\n'"ipv6=separate, but no upstreams line is in group=ipv6"
  fi
fi

# shellcheck disable=SC2016 # a Go template, for docker inspect
# Fields split on |, not spaces: read collapses empty fields between spaces,
# and a container with no user set has one.
format='{{index .Config.Labels "com.docker.compose.service"}}|{{.HostConfig.Privileged}}|{{.HostConfig.ReadonlyRootfs}}|{{.Config.User}}|{{.HostConfig.NetworkMode}}|{{json .HostConfig.CapAdd}}|{{range $p, $b := .HostConfig.PortBindings}}{{range $b}}{{$p}}={{.HostIp}}:{{.HostPort}};{{end}}{{end}}'
# The DNS tunnel's 53/udp, xhttp_reality_port and kcp_port are expected only
# where the gate forwards them.
forwards() { grep -q "\"tag\": *\"$1\"" "${gate}"; }
while IFS='|' read -r name privileged readonly user network caps ports; do
  [ -n "${name}" ] || continue
  [ "${privileged}" = false ] || violations+=$'\n'"${name} runs privileged"
  [ "${readonly}" = true ] || violations+=$'\n'"${name} has a writable root filesystem"
  [ "${network}" != host ] || violations+=$'\n'"${name} is on the host's network"
  if [ "${name}" = vpn ]; then
    # The OpenVPN client (the openvpn profile): root with NET_ADMIN alone,
    # and, its kill switch holding, no default route but into the tunnel.
    # Docker reports it with or without the CAP_ prefix, by version.
    [ "${caps//CAP_/}" = '["NET_ADMIN"]' ] ||
      violations+=$'\n'"vpn adds capabilities ${caps}, not NET_ADMIN alone"
    vpn_default=$(docker compose -p "${project}" exec -T vpn ip -4 route show default 2>/dev/null || true)
    case ${vpn_default} in '' | *" dev tun"*) ;; *) violations+=$'\n'"vpn has a default route around the tunnel: ${vpn_default}" ;; esac
  else
    [ "${user}" = 65532:65532 ] || violations+=$'\n'"${name} runs as '${user:-root}', not 65532:65532"
    case ${caps} in null | '[]') ;; *) violations+=$'\n'"${name} adds capabilities ${caps}" ;; esac
  fi
  for binding in ${ports//;/ }; do
    case ${name}/${binding} in
    gate/443/tcp=*:"${https_port}" | caddy/80/tcp=*:80) ;;
    gate/5353/udp=*:53) forwards public-dns || violations+=$'\n'"the gate publishes 53/udp with no DNS tunnel configured" ;;
    gate/8443/tcp=*:"${xhttp_reality_port}") forwards public-xhttp-reality ||
      violations+=$'\n'"the gate publishes ${xhttp_reality_port}/tcp with no XHTTP with REALITY configured" ;;
    gate/8447/udp=*:"${kcp_port}") forwards public-kcp ||
      violations+=$'\n'"the gate publishes ${kcp_port}/udp with no mKCP configured" ;;
    *) violations+=$'\n'"${name} publishes ${binding%%=*} on ${binding#*=}, which nothing should" ;;
    esac
  done
done < <(docker ps -q --filter "label=com.docker.compose.project=${project}" | xargs -r docker inspect -f "${format}")

# Xray's networks must all be internal: on any other, it has a route out.
xray=$(docker ps -q --filter "label=com.docker.compose.project=${project}" --filter label=com.docker.compose.service=xray)
if [ -n "${xray}" ]; then
  for net in $(docker inspect -f '{{range $n, $_ := .NetworkSettings.Networks}}{{$n}} {{end}}' "${xray}"); do
    [ "$(docker network inspect -f '{{.Internal}}' "${net}")" = true ] ||
      violations+=$'\n'"xray is on ${net}, a network with a route out"
  done
fi

violations=$(sed '/^$/d' <<<"${violations}")
[ -z "${violations}" ] && exit 0
# One line, for doctor's message; each violation also on its own line.
echo "policy: $(paste -sd ';' <<<"${violations}" | sed 's/;/; /g')" >&2
exit 1
