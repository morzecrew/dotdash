#!/usr/bin/env bash
# The release's health checks, one per argument:
#
#   cover-site  Caddy reports healthy, and the app behind the site, if
#               site_upstream names one, answers.
#   egress      Xray fetches probe_url through the gate and the upstreams,
#               now, and under ipv6=separate also probe6_url, which has an
#               IPv6 address only, through the IPv6 lines. When it cannot,
#               the message names what failed: the gate, or each upstreams
#               line by its name= (its address, its credentials, the
#               destination behind it, its tunnel), or an exit that no
#               longer matches probe_expect.
#
# Every upstream_mode falls through all of a group's lines before it fails, so
# a failed fetch means each line failed. Through Xray a refused login and a
# stopped proxy look alike (a 503, or a dropped tunnel), so each line is then
# asked directly, with its own credentials. `doctor` gives health checks 30s
# in all: two tries of 6s, then the first lines, at most 3s to connect and 6s
# to ask each, which leaves room for two.
set -euo pipefail

project=${DOTDASH_COMPOSE_PROJECT:-dotdash}

cover_site() {
  local health out app=${DOTDASH_PARAM_SITE_UPSTREAM:-none}
  health=$(docker compose -p "$project" ps --format '{{.Service}}={{.Health}}' | sed -n 's/^caddy=//p')
  [ "$health" = healthy ] || { echo "caddy is not healthy: ${health:-not running}" >&2; exit 1; }
  # The app behind the site (site_upstream) answers, asked from Caddy as Caddy
  # asks it. Any HTTP answer counts, a login wall's 401 included: only none
  # is a fault, which visitors would meet as a 502.
  [ "$app" != none ] || return 0
  if ! out=$(docker compose -p "$project" exec -T caddy wget -q -O /dev/null -T 5 "$app" 2>&1) &&
    ! grep -q 'server returned error' <<<"$out"; then
    echo "caddy is up, but the app behind the site (site_upstream) does not answer: ${out#wget: }; visitors get a 502" >&2
    exit 1
  fi
}

upstreams=${DOTDASH_SECRETS_DIR:-/run/dotdash/secrets}/upstreams

# ask_line <label> <line> <probe> <k>: asks one upstreams line directly, k
# its number among the OpenVPN lines. Prints what is wrong with it and returns
# 1, or returns 0 when it answers. Never prints the URL, which holds the
# line's credentials.
ask_line() {
  local label=$1 line=$2 url=$3 err errf rc code scheme
  case $line in
  wireguard://*)
    echo "$label (WireGuard): its peer did not carry it, and has no proxy to ask: it may be down, unreachable from here, or not know this key"
    return 1 ;;
  openvpn | openvpn://*)
    local t k=$4
    # Not from stdin, which is why()'s loop over the list: exec would read
    # the lines after this one.
    if ! docker compose -p "$project" ps --format '{{.Service}}' </dev/null | grep -qx vpn; then
      echo "$label (OpenVPN): the openvpn profile is off, so nothing carries the line"
    elif ! t=$(docker compose -p "$project" exec -T vpn /usr/local/bin/openvpn-entrypoint healthcheck "$k" </dev/null 2>&1); then
      echo "$label (OpenVPN, tun$k): the tunnel is down (${t##*unhealthy: }): its server may be down, unreachable from here, or refusing its config"
    else
      echo "$label (OpenVPN, tun$k): the tunnel is up, so the fault is past its server, or in the SOCKS hop beside it (vpn-socks)"
    fi
    return 1 ;;
  esac
  scheme=${line%%://*}
  local conn=${line#*://}
  # "[user:pass@]host:port", split as the gate's image splits it: at the last
  # "@", then the user up to the first ":". Neither half is ever printed.
  local at userinfo='' user='' pass='' host port
  at=${conn##*@}
  if [ "$at" != "$conn" ]; then userinfo=${conn%@*}; user=${userinfo%%:*} pass=${userinfo#*:}; fi
  port=${at##*:} host=${at%:*}
  if [ "$host" = "$at" ] || [ -z "$host" ] || [[ ! $port =~ ^[0-9]+$ ]]; then
    echo "$label: not \"[user:pass@]host:port\" after its scheme"
    return 1
  fi
  local bare=${host#[}
  bare=${bare%]}

  # shellcheck disable=SC2016 # $0 and $1 are the inner shell's
  if ! err=$(timeout 3 bash -c 'exec 3<>"/dev/tcp/$0/$1"' "$bare" "$port" 2>&1); then
    if [ -z "$err" ]; then
      echo "$label at $host:$port does not answer (no connection within 3s)"
    else
      err=${err%%$'\n'*}
      echo "$label: cannot connect to $host:$port: ${err##*: }"
    fi
    return 1
  fi
  if ! command -v curl >/dev/null; then
    echo "$label at $host:$port accepts connections; install curl to check its credentials"
    return 1
  fi
  case $scheme in
  socks5+tls) echo "$label at $host:$port accepts connections; curl cannot speak SOCKS over TLS to check further"; return 1 ;;
  socks | socks5) scheme=socks5h ;;
  https) scheme=https ;;
  *) scheme=http ;;
  esac

  # The credentials go to curl on stdin, never on its command line.
  errf=$(mktemp)
  rc=0
  code=$({ [ -z "$userinfo" ] || printf 'proxy-user = "%s:%s"\n' \
    "$(printf '%s' "$user" | sed 's/[\\"]/\\&/g')" "$(printf '%s' "$pass" | sed 's/[\\"]/\\&/g')"; } |
    curl -sS -o /dev/null -w '%{http_code}' --max-time 6 -K - \
      -x "$scheme://$host:$port" "$url" 2>"$errf") || rc=$?
  err=$(tr '\n' ' ' <"$errf")
  rm -f "$errf"

  if [ "$code" = 407 ] || [ "$rc" = 97 ] || [[ $err == *"response 407"* ]]; then
    echo "$label at $host:$port refused the credentials in its line"
  elif [ "$rc" = 0 ] && [[ $code == [23]* ]]; then
    return 0
  elif [ "$rc" = 0 ]; then
    echo "$label accepted the credentials, but $url answered $code through it"
  else
    echo "$label accepted the connection, but $url failed through it: ${err% }"
  fi
  return 1
}

# Why Xray's fetch ($1, the probe's last line) failed, as one line: each line
# of the group (<group>, $2: upstream, or ipv6) in order, or else Xray or the
# gate. At most the first two are asked, for doctor's 30s.
why() {
  local out=$1 group=${2:-upstream}
  case $out in
  *"does not match XRAY_HEALTHCHECK_EXPECT"*)
    echo "the exit changed: probe_url answered ${out##*XRAY_HEALTHCHECK_EXPECT: }, which probe_expect does not match"
    return ;;
  esac
  local probe=${DOTDASH_PARAM_PROBE_URL:-https://www.gstatic.com/generate_204}
  [ "$group" = upstream ] || probe=${DOTDASH_PARAM_PROBE6_URL:-http://api6.ipify.org}
  local n=0 asked=0 left=0 ovpn=0 k failed=() answered=() verdict line opts name groups o
  while read -r line opts || [ -n "${line:-}" ]; do
    n=$((n + 1))
    case $line in '' | '#'*) continue ;; esac
    # The k-th OpenVPN line in the file, whatever its groups, runs on tun<k>.
    k=$ovpn
    case $line in openvpn | openvpn://*) ovpn=$((ovpn + 1)) ;; esac
    name="line $n" groups=upstream
    for o in $opts; do
      case $o in name=*) name=${o#name=} ;; group=*) groups=${o#group=} ;; esac
    done
    case ",$groups," in *",$group,"*) ;; *) continue ;; esac
    if [ "$asked" -ge 2 ]; then left=$((left + 1)); continue; fi
    asked=$((asked + 1))
    if verdict=$(ask_line "$name" "$line" "$probe" "$k"); then answered+=("$name"); else failed+=("$verdict"); fi
  done <"$upstreams"
  if [ "$asked" = 0 ]; then
    echo "no upstreams line is in group $group: $out"
  elif [ "${#answered[@]}" -gt 0 ]; then
    echo "${answered[*]} answer(s) when asked directly, so the fault is in Xray or the gate: $out"
  else
    local msg=${failed[0]} i
    for ((i = 1; i < ${#failed[@]}; i++)); do msg+="; ${failed[i]}"; done
    [ "$left" = 0 ] || msg+="; $left more not asked"
    echo "$msg"
  fi
}

egress() {
  local out try gate
  gate=$(docker compose -p "$project" ps --format '{{.Service}}={{.State}}' | sed -n 's/^gate=//p')
  [ "$gate" = running ] || { echo "the gate, Xray's only way out, is not running: ${gate:-no container}" >&2; exit 1; }
  for try in 1 2; do
    if out=$(docker compose -p "$project" exec -T -e XRAY_HEALTHCHECK_TIMEOUT=6s xray \
      /usr/local/bin/xray-entrypoint healthcheck 2>&1); then
      return 0
    fi
    [ "$try" = 2 ] || sleep 1
  done
  out=$(tail -n1 <<<"$out")
  case $out in
  *"is not running"* | *"no such service"* | *"not running"*) echo "xray is not running" >&2; exit 1 ;;
  esac
  echo "Xray cannot fetch through the upstreams: $(why "$out")" >&2
  exit 1
}

# Under ipv6=separate: one fetch of a URL with an IPv6 address only, so it
# can leave through the IPv6 lines alone. probe_expect is about the IPv4 exit,
# so any answer will do.
egress6() {
  local out
  [ "${DOTDASH_PARAM_IPV6:-allow}" = separate ] || return 0
  if out=$(docker compose -p "$project" exec -T -e XRAY_HEALTHCHECK_TIMEOUT=6s \
    -e XRAY_HEALTHCHECK_URL="${DOTDASH_PARAM_PROBE6_URL:-http://api6.ipify.org}" -e XRAY_HEALTHCHECK_EXPECT='.*' \
    xray /usr/local/bin/xray-entrypoint healthcheck 2>&1); then
    return 0
  fi
  echo "Xray cannot fetch through the IPv6 lines: $(why "$(tail -n1 <<<"$out")" ipv6)" >&2
  exit 1
}

case ${1:-} in
cover-site) cover_site ;;
egress) egress; egress6 ;;
*) echo "usage: hooks/healthy cover-site|egress" >&2; exit 2 ;;
esac
