{
  "log": {"loglevel": "warning", "access": "none"},
  "inbounds": [{"tag": "probe", "listen": "0.0.0.0", "port": 10809, "protocol": "http"}],
  "outbounds": [{
    "tag": "dotdash", "protocol": "vless",
    "settings": {
      "address": "{{ required "set dotdash_address" .Parameters.dotdash_address }}", "port": {{ .Parameters.dotdash_port }},
      "id": {"$file": "/run/secrets/dotdash_id"},
      "encryption": {"$file": "/run/secrets/dotdash_encryption"}
    },
    "streamSettings": {"network": "xhttp", "security": "tls",
      "tlsSettings": {"serverName": "{{ .Parameters.dotdash_server }}", "alpn": ["h2"], "fingerprint": "chrome"},
      "xhttpSettings": {"path": {"$file": "/run/secrets/dotdash_xhttp_path"}, "host": "{{ .Parameters.dotdash_server }}", "mode": "auto"}
    }
  }]
}
