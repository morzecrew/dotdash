{{- /* dotdash-client's Xray config, beside the subscription's outbounds
(subscription.json.tmpl): a SOCKS5 and HTTP proxy port, and an unpublished
probe port for the health check and the subscription's refresh. Traffic goes
to whichever dotdash- outbound answers fastest, except what the rule
parameters refuse or send directly. Published beyond this machine, the proxy
asks for proxy_user and proxy_password. config-tun.json.tmpl repeats it, with
TUN and DNS added: keep the outbounds, observatory, balancer and the rules
both have the same, as the smoke test compares them.

A rule line is a classical rule without its target ("DOMAIN-SUFFIX,
example.com"), as the apps write them; "match" turns one into the fields of an
Xray routing rule. An IP rule matches an address the app gave, never one
looked up for a name (routing's domainStrategy AsIs), as no-resolve did. */ -}}
{{- define "match" -}}
{{- $f := split "," . -}}
{{- if lt (len $f) 2 }}{{ required (print "a rule needs a type and a value, such as DOMAIN-SUFFIX,example.com: " .) "" }}{{ end -}}
{{- $t := upper (index $f 0) -}}{{- $v := index $f 1 -}}
{{- if eq $t "DOMAIN" }}"domain": [{{ quote (print "full:" $v) }}]
{{- else if eq $t "DOMAIN-SUFFIX" }}"domain": [{{ quote (print "domain:" $v) }}]
{{- else if eq $t "DOMAIN-KEYWORD" }}"domain": [{{ quote (print "keyword:" $v) }}]
{{- else if eq $t "DOMAIN-REGEX" }}"domain": [{{ quote (print "regexp:" $v) }}]
{{- else if eq $t "GEOSITE" }}"domain": [{{ quote (print "geosite:" (lower $v)) }}]
{{- else if or (eq $t "IP-CIDR") (eq $t "IP-CIDR6") }}"ip": [{{ quote $v }}]
{{- else if eq $t "GEOIP" }}"ip": [{{ quote (print "geoip:" (lower $v)) }}]
{{- else if eq $t "DST-PORT" }}"port": {{ quote $v }}
{{- else }}{{ required (print "a rule's type is none of DOMAIN, DOMAIN-SUFFIX, DOMAIN-KEYWORD, DOMAIN-REGEX, GEOSITE, IP-CIDR, IP-CIDR6, GEOIP, DST-PORT: " .) "" }}
{{- end -}}
{{- end -}}
{{- $lan := ne (default "127.0.0.1" .Parameters.listen) "127.0.0.1" -}}
{{- $probe := required "set probe_url" .Parameters.probe_url -}}
{{- /* The openflux profile: when every link failed its last probe, the
balancer hands traffic to the OpenFlux client (compose/openflux.yaml), not to
the first link. Never probed: it is the way left, not one to pick. */ -}}
{{- $openflux := has "openflux" .Profiles -}}
{{- /* cdn=skip: the balancer and its probes take every link but those
through a CDN (dotdash-cdn-*): the servers' (dotdash-<n>-*) and the relays'
(dotdash-relay-*). Xray picks outbounds by tag prefix alone. */ -}}
{{- $links := `"dotdash-"` }}{{ if eq .Parameters.cdn "skip" }}{{ $links = `"dotdash-1", "dotdash-2", "dotdash-3", "dotdash-4", "dotdash-5", "dotdash-6", "dotdash-7", "dotdash-8", "dotdash-9", "dotdash-relay-"` }}{{ end -}}
{
  "log": {"loglevel": "warning"},
  "inbounds": [
    {"tag": "proxy", "listen": "0.0.0.0", "port": 7890, "protocol": "socks",
     "settings": {"udp": true{{ if $lan }}, "auth": "password",
       "accounts": [{"user": "{{ required "set proxy_user" .Parameters.proxy_user }}", "pass": {"$file": "/run/secrets/proxy_password"}}]{{ end }}}},
    {"tag": "probe", "listen": "127.0.0.1", "port": 7891, "protocol": "socks", "settings": {"udp": true}}
  ],
  {{- /* The subscription's outbounds go before these (compose.yaml), so what
  the balancer can't place, as when every link failed its last probe, takes
  the first link, and dotdash back from an outage carries traffic before the
  next probe. While the subscription has given no links yet, block takes it:
  so nothing leaves around dotdash. */}}
  "outbounds": [
    {"tag": "block", "protocol": "blackhole"},
    {"tag": "direct", "protocol": "freedom"}
    {{- if $openflux }},
    {"tag": "openflux", "protocol": "socks", "settings": {"address": "openflux", "port": 1080}}
    {{- end }}
  ],
  {{- /* Each link is probed once a minute at a moment of its own, not all of
  them together, which would tie this device's links to each other for
  whoever watches several of them: burstObservatory, which leastPing reads
  as it read observatory. */}}
  "burstObservatory": {"subjectSelector": [{{ $links }}], "pingConfig": {"destination": "{{ $probe }}", "interval": "1m", "sampling": 1}},
  "routing": {
    "domainStrategy": "AsIs",
    "balancers": [{"tag": "dotdash", "selector": [{{ $links }}], "strategy": {"type": "leastPing"}{{ if $openflux }}, "fallbackTag": "openflux"{{ end }}}],
    "rules": [
      {{- /* ipv6=block: every IPv6 address refused first, a direct rule's
      included. */}}
      {{- if eq .Parameters.ipv6 "block" }}
      {"type": "field", "ip": ["::/0"], "outboundTag": "block"},
      {{- end }}
      {{- /* The health check and the subscription's refresh go to dotdash
      whatever the rules say. */}}
      {"type": "field", "inboundTag": ["probe"], "balancerTag": "dotdash"},
      {{- /* Each kept line of the rule parameters, blank and "#" lines
      skipped; backslashes doubled before quote, which escapes only quotes. */}}
      {{- range lines .Parameters.block_rules }}{{ $l := replace (trim .) "\\" "\\\\" }}{{ if and $l (ne (slice $l 0 1) "#") }}
      {"type": "field", {{ template "match" $l }}, "outboundTag": "block"},
      {{- end }}{{ end }}
      {{- /* Proxy rules after block rules and before direct rules: what both a
      proxy and a direct rule match goes through dotdash. */}}
      {{- range lines .Parameters.proxy_rules }}{{ $l := replace (trim .) "\\" "\\\\" }}{{ if and $l (ne (slice $l 0 1) "#") }}
      {"type": "field", {{ template "match" $l }}, "balancerTag": "dotdash"},
      {{- end }}{{ end }}
      {{- range lines .Parameters.direct_rules }}{{ $l := replace (trim .) "\\" "\\\\" }}{{ if and $l (ne (slice $l 0 1) "#") }}
      {"type": "field", {{ template "match" $l }}, "outboundTag": "direct"},
      {{- end }}{{ end }}
      {"type": "field", "network": "tcp,udp", "balancerTag": "dotdash"}
    ]
  }
}
