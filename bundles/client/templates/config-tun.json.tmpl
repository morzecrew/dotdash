{{- /* The tun profile's config (compose/tun.yaml mounts it in place of
config.json.tmpl's): the same outbounds, observatory, balancer and rules, plus
TUN, which takes every connection on the machine, its containers' and IPv6
included, and DNS answered with fake addresses whose names go to dotdash.
On the host's network, so the proxy port listens on the listen address
itself. Rules only this file has name a TUN-only inbound (tun, dns-in,
resolver) or the DNS module's tag (dns-internal); the smoke test drops those,
the dns outbound, the inbounds, dns and fakedns, and compares the rest.

Xray's own lookups, of dotdash's server names and of what direct rules send
around it, go through the system resolver, which /etc/resolv.conf
(resolv.conf.tmpl) points at the resolver inbound on 127.53.0.1:53: that
forwards them directly, from Xray's own socket outside TUN, to dns_server.
The host's own resolver would send them into TUN and get fake addresses
back. */ -}}
{{- define "match" -}}
{{- $f := split "," . -}}
{{- if lt (len $f) 2 }}{{ required (print "a rule needs a type and a value, such as DOMAIN-SUFFIX,example.com: " .) "" }}{{ end -}}
{{- $t := upper (index $f 0) -}}{{- $v := index $f 1 -}}
{{- if eq $t "DOMAIN" }}"domain": [{{ quote (print "full:" $v) }}]
{{- else if eq $t "DOMAIN-SUFFIX" }}"domain": [{{ quote (print "domain:" $v) }}]
{{- else if eq $t "DOMAIN-KEYWORD" }}"domain": [{{ quote (print "keyword:" $v) }}]
{{- else if eq $t "DOMAIN-REGEX" }}"domain": [{{ quote (print "regexp:" $v) }}]
{{- else if eq $t "GEOSITE" }}"domain": [{{ quote (print "geosite:" (lower $v)) }}]
{{- else if or (eq $t "IP-CIDR") (eq $t "IP-CIDR6") }}"ip": [{{ quote $v }}]
{{- else if eq $t "GEOIP" }}"ip": [{{ quote (print "geoip:" (lower $v)) }}]
{{- else if eq $t "DST-PORT" }}"port": {{ quote $v }}
{{- else }}{{ required (print "a rule's type is none of DOMAIN, DOMAIN-SUFFIX, DOMAIN-KEYWORD, DOMAIN-REGEX, GEOSITE, IP-CIDR, IP-CIDR6, GEOIP, DST-PORT: " .) "" }}
{{- end -}}
{{- end -}}
{{- $lan := ne (default "127.0.0.1" .Parameters.listen) "127.0.0.1" -}}
{{- $probe := required "set probe_url" .Parameters.probe_url -}}
{{- $resolver := required "set dns_server" .Parameters.dns_server -}}
{
  "log": {"loglevel": "warning"},
  {{- /* Names asked on port 53 through TUN, or on dns_listen, get a fake
  address from 198.18.0.0/15; a connection to it goes to dotdash with the
  name, which the server resolves. IPv4 only: AAAA questions get no answer,
  so apps use IPv4. The LAN's own names are asked of dns_server, as is. */}}
  "dns": {
    "tag": "dns-internal",
    "queryStrategy": "UseIPv4",
    "servers": [
      {"address": "{{ $resolver }}", "domains": ["domain:lan", "domain:local", "domain:home.arpa"], "skipFallback": true},
      "fakedns"
    ]
  },
  "fakedns": [{"ipPool": "198.18.0.0/15", "poolSize": 65535}],
  "inbounds": [
    {"tag": "proxy", "listen": "{{ default "127.0.0.1" .Parameters.listen }}", "port": {{ .Parameters.port }}, "protocol": "socks",
     "settings": {"udp": true{{ if $lan }}, "auth": "password",
       "accounts": [{"user": "{{ required "set proxy_user" .Parameters.proxy_user }}", "pass": {"$file": "/run/secrets/proxy_password"}}]{{ end }}}},
    {"tag": "probe", "listen": "127.0.0.1", "port": 7891, "protocol": "socks", "settings": {"udp": true}},
    {{- /* Everything, IPv4 and IPv6, into the interface Meta (the gateway
    check and its DOCKER-USER rules name it), as two halves of each family:
    Xray adds its routes at metric 1, which a default route at metric 0
    would beat, and a half is more specific than any default. Networks the
    host is on are more specific still, and stay direct. Xray's own sockets
    are bound to the main interface, outside TUN. */}}
    {"tag": "tun", "protocol": "tun",
     "settings": {"name": "Meta", "MTU": 1500, "autoSystemRoutingTable": ["0.0.0.0/1", "128.0.0.0/1", "::/1", "8000::/1"], "autoOutboundsInterface": "auto"},
     "sniffing": {"enabled": true, "destOverride": ["fakedns", "http", "tls", "quic"]}},
    {"tag": "resolver", "listen": "127.53.0.1", "port": 53, "protocol": "dokodemo-door",
     "settings": {"address": "{{ $resolver }}", "port": 53, "network": "tcp,udp"}}
    {{- /* morzer wants a default for every parameter, so "none" means none. */}}
    {{- if ne .Parameters.dns_listen "none" }}{{ $d := split ":" .Parameters.dns_listen }},
    {"tag": "dns-in", "listen": "{{ index $d 0 }}", "port": {{ index $d 1 }}, "protocol": "dokodemo-door",
     "settings": {"address": "{{ $resolver }}", "port": 53, "network": "tcp,udp"}}
    {{- end }}
  ],
  "outbounds": [
    {"tag": "block", "protocol": "blackhole"},
    {"tag": "direct", "protocol": "freedom"},
    {"tag": "dns", "protocol": "dns"}
  ],
  "observatory": {"subjectSelector": ["dotdash-"], "probeUrl": "{{ $probe }}", "probeInterval": "1m", "enableConcurrency": true},
  "routing": {
    "domainStrategy": "AsIs",
    "balancers": [{"tag": "dotdash", "selector": ["dotdash-"], "strategy": {"type": "leastPing"}}],
    "rules": [
      {"type": "field", "inboundTag": ["resolver", "dns-internal"], "outboundTag": "direct"},
      {"type": "field", "inboundTag": ["tun", "dns-in"], "port": "53", "outboundTag": "dns"},
      {{- if eq .Parameters.ipv6 "block" }}
      {"type": "field", "ip": ["::/0"], "outboundTag": "block"},
      {{- end }}
      {"type": "field", "inboundTag": ["probe"], "balancerTag": "dotdash"},
      {{- range lines .Parameters.block_rules }}{{ $l := replace (trim .) "\\" "\\\\" }}{{ if and $l (ne (slice $l 0 1) "#") }}
      {"type": "field", {{ template "match" $l }}, "outboundTag": "block"},
      {{- end }}{{ end }}
      {{- range lines .Parameters.direct_rules }}{{ $l := replace (trim .) "\\" "\\\\" }}{{ if and $l (ne (slice $l 0 1) "#") }}
      {"type": "field", {{ template "match" $l }}, "outboundTag": "direct"},
      {{- end }}{{ end }}
      {"type": "field", "network": "tcp,udp", "balancerTag": "dotdash"}
    ]
  }
}
