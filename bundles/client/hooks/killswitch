#!/bin/sh
# The kill switch check: under the tun profile (its TUN interface is up), the
# killswitch service's rules are in place, IPv6's too where the host has it,
# so nothing goes around dotdash while Xray restarts, DNS to a LAN resolver
# included (killswitch/killswitch.sh).
ip link show Meta >/dev/null 2>&1 || { echo "not under the tun profile (no TUN interface)"; exit 0; }
fams=-4
[ ! -e /proc/net/if_inet6 ] || fams="-4 -6"
for fam in $fams; do
  for pref in 8996 8997 8998 8999 9001 9002; do
    ip "$fam" rule show pref "$pref" | grep -q . \
      || { echo "TUN is up, but the kill switch's rules are not (no ip $fam rule $pref): is the killswitch service running? sudo docker ps -f name=killswitch" >&2; exit 1; }
  done
done
# systemd-resolved sends what it asks a link's own DNS servers (DHCP's) out
# of that link, which no routing rule takes into TUN: a warning, as the
# machine still goes through dotdash, until resolved asks one server for
# every name (Domains=~., client/tun.md).
links=$(resolvectl dns 2>/dev/null | sed -n 's/^Link [0-9]* (\([^)]*\)): *\([^ ].*\)$/\1 (\2)/p' | grep -v '^Meta ' | tr '\n' ' ')
if [ -n "$links" ] && ! resolvectl domain 2>/dev/null | grep -q '^Global:.* ~\.'; then
  echo "the kill switch is on, but systemd-resolved asks the DNS servers of ${links}around dotdash: see the client's tun page, \"systemd-resolved\""
  exit 0
fi
echo "the kill switch is on: with Xray gone, nothing leaves around dotdash"
