#!/usr/bin/env bash
# The release's health checks, one per argument:
#
#   cover-site  Caddy reports healthy.
#   egress      Xray fetches healthcheck_url through the gate and the upstream,
#               now, and with the IPv6 proxy also healthcheck6_url, which has
#               an IPv6 address only, through the IPv6 proxy. When it cannot,
#               the message names the layer that failed: the gate, a proxy's
#               address, its credentials, the destination behind it, or an
#               exit that no longer matches healthcheck_expect.
#
# Through Xray a refused login and a stopped upstream look alike (a 503, or a
# dropped tunnel), so a failed fetch is followed by asking the upstream
# directly, with the same credentials. `doctor` gives health checks 30s in all:
# two tries of 6s, then at most 3s to connect and 6s to ask.
set -euo pipefail

project=${DOTDASH_COMPOSE_PROJECT:-dotdash}

cover_site() {
  local health
  health=$(docker compose -p "$project" ps --format '{{.Service}}={{.Health}}' | sed -n 's/^caddy=//p')
  [ "$health" = healthy ] || { echo "caddy is not healthy: ${health:-not running}" >&2; exit 1; }
}

# Asks one proxy directly, with its credentials: <family> is 4 for the
# upstream secret's, 6 for upstream6's. Prints what is wrong with it and
# returns 1, or returns 0 when it answers.
ask_upstream() {
  local fam=$1 p=UPSTREAM label="the upstream proxy" name=upstream
  if [ "$fam" = 6 ]; then p=UPSTREAM6 label="the IPv6 proxy" name=upstream6; fi
  local rv="DOTDASH_PARAM_${p}_PROTOCOL" tv="DOTDASH_PARAM_${p}_TLS"
  local protocol=${!rv:-socks} tls=${!tv:-false}
  local url=${DOTDASH_PARAM_HEALTHCHECK_URL:-https://www.gstatic.com/generate_204}
  local secrets=${DOTDASH_SECRETS_DIR:-/run/dotdash/secrets} err errf rc code scheme
  [ "$fam" = 4 ] || url=${DOTDASH_PARAM_HEALTHCHECK6_URL:-http://api6.ipify.org}

  # "[user:pass@]host:port", split as the gate's image splits it: at the last
  # "@", then the user up to the first ":". Neither half is ever printed.
  local conn at userinfo='' user='' pass='' host port
  conn=$(cat "$secrets/$name")
  at=${conn##*@}
  if [ "$at" != "$conn" ]; then userinfo=${conn%@*}; user=${userinfo%%:*} pass=${userinfo#*:}; fi
  port=${at##*:} host=${at%:*}
  if [ "$host" = "$at" ] || [ -z "$host" ] || [[ ! $port =~ ^[0-9]+$ ]]; then
    echo "the $name secret is not \"user:pass@host:port\""
    return 1
  fi
  local bare=${host#[}
  bare=${bare%]}

  # shellcheck disable=SC2016 # $0 and $1 are the inner shell's
  if ! err=$(timeout 3 bash -c 'exec 3<>"/dev/tcp/$0/$1"' "$bare" "$port" 2>&1); then
    if [ -z "$err" ]; then
      echo "$label at $host:$port does not answer (no connection within 3s)"
    else
      err=${err%%$'\n'*}
      echo "cannot connect to $label at $host:$port: ${err##*: }"
    fi
    return 1
  fi
  if ! command -v curl >/dev/null; then
    echo "$label at $host:$port accepts connections; install curl to check its credentials"
    return 1
  fi
  case $protocol/$tls in
  socks/true) echo "$label at $host:$port accepts connections; curl cannot speak SOCKS over TLS to check further"; return 1 ;;
  socks/*) scheme=socks5h ;;
  http/true) scheme=https ;;
  *) scheme=http ;;
  esac

  # The credentials go to curl on stdin, never on its command line.
  errf=$(mktemp)
  rc=0
  code=$({ [ -z "$userinfo" ] || printf 'proxy-user = "%s:%s"\n' \
    "$(printf '%s' "$user" | sed 's/[\\"]/\\&/g')" "$(printf '%s' "$pass" | sed 's/[\\"]/\\&/g')"; } |
    curl -sS -o /dev/null -w '%{http_code}' --max-time 6 -K - \
      -x "$scheme://$host:$port" "$url" 2>"$errf") || rc=$?
  err=$(tr '\n' ' ' <"$errf")
  rm -f "$errf"

  if [ "$code" = 407 ] || [ "$rc" = 97 ] || [[ $err == *"response 407"* ]]; then
    echo "$label at $host:$port refused the credentials in the $name secret"
  elif [ "$rc" = 0 ] && [[ $code == [23]* ]]; then
    return 0
  elif [ "$rc" = 0 ]; then
    echo "$label accepted the credentials, but $url answered $code through it"
  else
    echo "$label accepted the connection, but $url failed through it: ${err% }"
  fi
  return 1
}

# Why Xray's fetch ($1, the probe's last line) failed, as one line: the proxy
# at fault, the IPv6 one first when <family> ($2) is 6, or else Xray or the gate.
why() {
  local out=$1 fam=${2:-4}
  case $out in
  *"does not match XRAY_HEALTHCHECK_EXPECT"*)
    echo "the exit changed: healthcheck_url answered ${out##*XRAY_HEALTHCHECK_EXPECT: }, which healthcheck_expect does not match"
    return ;;
  esac
  local order=4
  if [ "${DOTDASH_PARAM_UPSTREAM6_PROTOCOL:-none}" != none ]; then
    if [ "$fam" = 6 ]; then order="6 4"; else order="4 6"; fi
  fi
  # A tunnel has no proxy to ask: name what holds it.
  if [ "$fam" = 4 ]; then
    case ${DOTDASH_PARAM_UPSTREAM_PROTOCOL:-socks} in
    wireguard)
      echo "the WireGuard peer in the upstream_wireguard secret did not carry it: it may be down, unreachable from here, or not know this key: $out"
      return ;;
    openvpn)
      local t
      if ! t=$(docker compose -p "$project" exec -T vpn /usr/local/bin/openvpn-entrypoint healthcheck 2>&1); then
        echo "the OpenVPN tunnel is down (${t##*unhealthy: }): its server in the upstream_openvpn secret may be down, unreachable from here, or refusing this config"
      else
        echo "the OpenVPN tunnel is up, so the fault is past its server, or in the SOCKS hop beside it (vpn-socks): $out"
      fi
      return ;;
    esac
  fi
  local f
  for f in $order; do
    ask_upstream "$f" || return 0
  done
  echo "the proxies answer when asked directly, so the fault is in Xray or the gate: $out"
}

egress() {
  local out try gate
  gate=$(docker compose -p "$project" ps --format '{{.Service}}={{.State}}' | sed -n 's/^gate=//p')
  [ "$gate" = running ] || { echo "the gate, Xray's only way out, is not running: ${gate:-no container}" >&2; exit 1; }
  for try in 1 2; do
    if out=$(docker compose -p "$project" exec -T -e XRAY_HEALTHCHECK_TIMEOUT=6s xray \
      /usr/local/bin/xray-entrypoint healthcheck 2>&1); then
      return 0
    fi
    [ "$try" = 2 ] || sleep 1
  done
  out=$(tail -n1 <<<"$out")
  case $out in
  *"is not running"* | *"no such service"* | *"not running"*) echo "xray is not running" >&2; exit 1 ;;
  esac
  echo "Xray cannot fetch through the upstream: $(why "$out")" >&2
  exit 1
}

# With the IPv6 proxy: one fetch of a URL with an IPv6 address only, so it can
# leave through the IPv6 proxy alone. healthcheck_expect is about the IPv4
# exit, so any answer will do.
egress6() {
  local out
  [ "${DOTDASH_PARAM_UPSTREAM6_PROTOCOL:-none}" != none ] || return 0
  if out=$(docker compose -p "$project" exec -T -e XRAY_HEALTHCHECK_TIMEOUT=6s \
    -e XRAY_HEALTHCHECK_URL="${DOTDASH_PARAM_HEALTHCHECK6_URL:-http://api6.ipify.org}" -e XRAY_HEALTHCHECK_EXPECT='.*' \
    xray /usr/local/bin/xray-entrypoint healthcheck 2>&1); then
    return 0
  fi
  echo "Xray cannot fetch through the IPv6 proxy: $(why "$(tail -n1 <<<"$out")" 6)" >&2
  exit 1
}

case ${1:-} in
cover-site) cover_site ;;
egress) egress; egress6 ;;
*) echo "usage: hooks/healthy cover-site|egress" >&2; exit 2 ;;
esac
