#!/usr/bin/env bash
# What no healthcheck sees: from outside, the TLS port must look like the cover
# site, with a certificate a browser trusts. That proves REALITY relays anything
# without its key to Caddy, and that Caddy got its certificate. The first
# issuance takes a moment, so this retries for up to 90s.
set -euo pipefail

domain=${DOTDASH_DOMAIN:?install with --domain}
port=${DOTDASH_PARAM_HTTPS_PORT:?}

if ! command -v curl >/dev/null; then
  echo "curl not installed; cannot check the cover site" >&2
  exit 2
fi

for _ in $(seq 18); do
  if err=$(curl -sS --fail --noproxy '*' -o /dev/null --max-time 5 \
    --resolve "$domain:$port:127.0.0.1" "https://$domain:$port/" 2>&1); then
    exit 0
  fi
  sleep 5
done
echo "cover site not served on 127.0.0.1:$port: $err" >&2
exit 1
