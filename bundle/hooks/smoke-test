#!/usr/bin/env bash
# What no healthcheck sees: from outside, the TLS port must look like the cover
# site, with a certificate a browser trusts. That proves REALITY relays anything
# without its key to Caddy, and that Caddy got its certificate. The first
# issuance takes a moment, so this retries for up to 90s.
set -euo pipefail

port=${DOTDASH_PARAM_HTTPS_PORT:?}
project=${DOTDASH_COMPOSE_PROJECT:-dotdash}

if ! command -v curl >/dev/null; then
  echo "curl not installed; cannot check the cover site" >&2
  exit 2
fi

caddy=$(docker ps -q --filter "label=com.docker.compose.project=$project" \
  --filter label=com.docker.compose.service=caddy | sed -n 1p)
[ -n "$caddy" ] || { echo "no running caddy container in project $project" >&2; exit 1; }
# A hook is given no domain; the one Caddy serves is in its environment.
domain=$(docker exec "$caddy" printenv DOMAIN)

# With cert_issuer=internal "trusted" means signed by Caddy's own root.
ca=()
if [ "${DOTDASH_PARAM_CERT_ISSUER:-acme}" = internal ]; then
  root=$(mktemp)
  trap 'rm -f "$root"' EXIT
  ca=(--cacert "$root")
fi

for _ in $(seq 18); do
  if [ ${#ca[@]} -gt 0 ]; then
    docker exec "$caddy" cat /data/caddy/pki/authorities/local/root.crt >"$root" 2>/dev/null || true
  fi
  if err=$(curl -sS --fail --noproxy '*' -o /dev/null --max-time 5 "${ca[@]}" \
    --resolve "$domain:$port:127.0.0.1" "https://$domain:$port/" 2>&1); then
    exit 0
  fi
  sleep 5
done
echo "cover site not served on 127.0.0.1:$port: $err" >&2
exit 1
