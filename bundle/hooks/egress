#!/usr/bin/env bash
# The fatal preflight check `doctor` runs: Xray fetches healthcheck_url through
# the upstream proxy, now. An unhealthy container alone only warns in doctor
# (morzer reads it as not running), so this is what makes a broken upstream an
# error, which a notify target hears at its default level. Three tries, so one
# lost request is not an alert. Before an operation there is nothing to probe
# yet, and it must not block one: exit 2 passes as not applicable.
set -euo pipefail

if [ "${DOTDASH_PHASE:-}" = preflight ] && [ "${DOTDASH_OPERATION_TYPE:-}" != doctor ]; then
  exit 2
fi

project=${DOTDASH_COMPOSE_PROJECT:-dotdash}
for try in 1 2 3; do
  if out=$(docker compose -p "$project" exec -T xray /usr/local/bin/xray-entrypoint healthcheck 2>&1); then
    exit 0
  fi
  [ "$try" = 3 ] || sleep 5
done
echo "Xray cannot reach the internet through the upstream proxy: $out" >&2
exit 1
